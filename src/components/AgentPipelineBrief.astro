---
import type { AISystem } from '../data/ai-systems';

interface Props {
  workflow: NonNullable<AISystem['workflow']>;
  diagramsOnly?: boolean;
}

const { workflow, diagramsOnly = false } = Astro.props;
const lanes = workflow.roles.map((role) => role.name);
const handoffs = workflow.handoffs.map((handoff) => {
  const from = lanes.indexOf(handoff.from) + 1;
  const to = lanes.indexOf(handoff.to) + 1;
  const span = Math.abs(to - from) + 1;

  return {
    ...handoff,
    start: Math.min(from, to),
    end: Math.max(from, to),
    fromIndex: from,
    reverse: from > to,
    endpointInset: `calc(${50 / span}% - ${(6 * (span - 1)) / span}px)`,
  };
});
---

<section class="my-12 space-y-10" aria-labelledby="pipeline-workflow-heading">
  <figure class="border-y border-line py-7">
    <div
      class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 mb-6"
    >
      <div>
        <div
          class="text-[10px] font-mono font-semibold uppercase tracking-[0.18em] text-accent mb-2"
        >
          Workflow chart
        </div>
        <h2
          id="pipeline-workflow-heading"
          class="text-lg sm:text-xl font-display font-bold text-foreground"
        >
          From sprint-ready ticket to final verdict
        </h2>
      </div>
      <span
        class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold text-emerald-300"
      >
        <span class="w-2 h-2 rounded-full bg-accent" aria-hidden="true"></span>
        {workflow.reviewLabel}
      </span>
    </div>

    <div class="overflow-x-auto pb-2">
      <ol class="min-w-[760px] grid grid-cols-7">
        {
          workflow.nodes.map((node) => (
            <li
              class:list={[
                'pipeline-node relative text-center pt-7 px-2 text-[10px] font-mono font-semibold uppercase leading-tight text-body',
                { 'human-gate': node.humanGate },
              ]}
            >
              <span>{node.label}</span>
              {node.command && (
                <code class="block mt-1.5 text-[10px] normal-case text-accent">
                  {node.command}
                </code>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </figure>

  <figure class="pt-2">
    <figcaption class="mb-6">
      <span
        class="block text-[10px] font-mono font-semibold uppercase tracking-[0.18em] text-accent"
      >
        Review sequence
      </span>
    </figcaption>

    <div class="overflow-x-auto pb-3">
      <div
        class="architecture-diagram min-w-[900px] rounded-xl bg-surface-deep border border-line p-4"
      >
        <div class="grid grid-cols-6 gap-3 mb-3">
          {
            workflow.roles.map((role) => (
              <div
                class="rounded-lg bg-surface-raised border border-line p-2.5 text-center"
                aria-label={`${role.name} lane`}
              >
                <strong class="block text-[11px] text-foreground">
                  {role.name}
                </strong>
                <span class="block mt-0.5 text-[9px] font-mono uppercase tracking-wider text-faint">
                  {role.model}
                </span>
              </div>
            ))
          }
        </div>

        <div class="sequence-grid relative">
          <div
            class="lane-guides absolute inset-0 grid grid-cols-6 gap-3 pointer-events-none"
            aria-hidden="true"
          >
            {lanes.map(() => <span />)}
          </div>

          <ol class="relative space-y-2 py-2">
            {
              handoffs.map((handoff, index) => (
                <>
                  {handoff.artifact && (
                    <li class="grid grid-cols-6 gap-3 min-h-12 items-center">
                      <div
                        class="processing-loop mx-auto inline-flex items-center gap-2 rounded-lg bg-emerald-500/[0.04] border border-emerald-500/20 px-2.5 py-2"
                        style={`grid-column: ${handoff.fromIndex}`}
                        aria-label={`${handoff.from} output: ${handoff.artifact}`}
                      >
                        <span
                          class="text-base leading-none text-emerald-400"
                          aria-hidden="true"
                        >
                          ↻
                        </span>
                        <code class="text-[9px] font-mono font-semibold text-emerald-200 whitespace-nowrap">
                          {handoff.artifact}
                        </code>
                      </div>
                    </li>
                  )}

                  <li class="grid grid-cols-6 gap-3 min-h-14 items-center">
                    <div
                      class:list={[
                        'sequence-exchange relative flex items-center px-5 py-2',
                        { reverse: handoff.reverse },
                        { 'human-review': handoff.humanReview },
                      ]}
                      style={`grid-column: ${handoff.start} / ${handoff.end + 1}; --endpoint-inset: ${handoff.endpointInset}`}
                    >
                      <div class="sequence-label mx-auto max-w-[150px] rounded-md bg-surface-raised border border-line px-2.5 py-1.5 text-center">
                        <span class="block text-[9px] font-mono text-muted">
                          {String(index + 1).padStart(2, '0')} ·{' '}
                          {handoff.artifact ?? handoff.label}
                        </span>
                      </div>
                    </div>
                  </li>
                </>
              ))
            }
          </ol>
        </div>

        <div
          class="mt-3 flex items-center justify-between gap-4 rounded-lg bg-emerald-500/[0.04] border border-emerald-500/15 px-3 py-2 text-[9px] font-mono"
        >
          <span class="text-emerald-300">● Human approval checkpoint</span>
          <span class="text-muted"
            >Final PR and merge decision remains manual</span
          >
        </div>
      </div>
    </div>
  </figure>
</section>

<style>
  .pipeline-node::before {
    content: '';
    position: absolute;
    z-index: 2;
    top: 0.2rem;
    left: 50%;
    width: 0.7rem;
    height: 0.7rem;
    transform: translateX(-50%);
    border: 2px solid rgb(var(--accent));
    border-radius: 9999px;
    background: rgb(var(--surface));
  }

  .pipeline-node::after {
    content: '';
    position: absolute;
    top: 0.53rem;
    right: 0;
    left: 0;
    height: 1px;
    background: rgb(var(--line));
  }

  .pipeline-node:first-child::after {
    left: 50%;
  }

  .pipeline-node:last-child::after {
    right: 50%;
  }

  .pipeline-node.human-gate::before {
    border-color: #34d399;
    box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.08);
  }

  .lane-guides span {
    height: 100%;
    margin-left: 50%;
    border-left: 1px solid rgb(var(--line));
  }

  .sequence-exchange::before {
    content: '';
    position: absolute;
    top: 50%;
    right: var(--endpoint-inset);
    left: var(--endpoint-inset);
    height: 2px;
    background: rgb(var(--accent));
  }

  .sequence-exchange::after {
    content: '';
    position: absolute;
    top: calc(50% - 4px);
    right: calc(var(--endpoint-inset) - 2px);
    width: 9px;
    height: 9px;
    border-top: 2px solid rgb(var(--accent));
    border-right: 2px solid rgb(var(--accent));
    transform: rotate(45deg);
  }

  .sequence-exchange.reverse::after {
    right: auto;
    left: calc(var(--endpoint-inset) - 2px);
    transform: rotate(-135deg);
  }

  .sequence-exchange.human-review::before {
    background: repeating-linear-gradient(
      to right,
      #34d399 0,
      #34d399 6px,
      transparent 6px,
      transparent 11px
    );
  }

  .sequence-exchange.human-review::after {
    border-color: #34d399;
  }

  .sequence-label {
    position: relative;
    z-index: 1;
  }

  @media (forced-colors: active) {
    .lane-guides span {
      border-left-color: CanvasText;
    }
    .pipeline-node::before {
      border-color: CanvasText;
      background: Canvas;
    }
    .pipeline-node::after,
    .sequence-exchange::before,
    .sequence-exchange.human-review::before {
      background: CanvasText;
      forced-color-adjust: none;
    }
    .sequence-exchange::after {
      border-top-color: CanvasText;
      border-right-color: CanvasText;
      forced-color-adjust: none;
    }
  }
</style>
