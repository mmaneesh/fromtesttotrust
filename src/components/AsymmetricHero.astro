---
import { siteConfig } from '../data/site-config';
---

<section class="w-full pt-10 pb-8 sm:pt-14 sm:pb-10 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- Left Column: Portrait, Name & Hero Headline (8 cols) -->
      <div
        class="lg:col-span-8 flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-8"
      >
        <!-- Portrait Frame -->
        <div class="relative shrink-0">
          <div
            class="w-28 h-28 sm:w-36 sm:h-36 rounded-2xl overflow-hidden border border-white/20 shadow-2xl p-0.5 bg-[#121824]"
          >
            <img
              src="/images/maneesh-portrait.jpg"
              alt="Maneesh Maddala"
              class="w-full h-full object-cover rounded-2xl filter contrast-105"
            />
          </div>
        </div>

        <!-- Identity & Headline -->
        <div class="flex flex-col">
          <div
            class="text-sm sm:text-base font-medium text-slate-300 mb-1 flex items-center gap-2"
          >
            <span>{siteConfig.name}</span>
            <span
              class="text-xs font-mono text-accent px-2 py-0.5 rounded-full bg-accent/10 border border-accent/20"
            >
              AI / QE Leader
            </span>
          </div>

          <h1
            class="text-3xl sm:text-4xl lg:text-[44px] font-display font-extrabold text-white leading-[1.12] tracking-tight mb-3"
          >
            From testing software<br class="hidden sm:inline" /> to engineering trust
          </h1>

          <p class="text-xs sm:text-sm font-mono text-slate-400">
            {siteConfig.role} · {siteConfig.employer}
          </p>
        </div>
      </div>

      <!-- Right Column: Current Focus Micro-Panel (4 cols) -->
      <div class="lg:col-span-4">
        <div
          class="rounded-2xl bg-[#0B0F19] border border-white/10 p-5 shadow-2xl relative"
        >
          <div class="flex items-center justify-between mb-3.5">
            <h2
              class="text-xs font-mono font-medium text-slate-400 uppercase tracking-wider"
            >
              Current Focus
            </h2>
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"
            ></span>
          </div>

          <div class="space-y-2.5">
            {
              siteConfig.currentFocus.map((focus) => (
                <div class="px-3.5 py-2.5 rounded-xl bg-[#131A29]/70 border border-white/[0.07] text-xs text-slate-200 font-medium hover:border-accent/40 transition-colors flex items-center justify-between">
                  <span>{focus.title}</span>
                  <span class="text-[10px] font-mono text-accent/70">→</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
