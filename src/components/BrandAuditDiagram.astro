        <g transform="translate(345,322)"
          ><rect x="-128" y="-9" width="256" height="16" rx="3"></rect><text
            text-anchor="middle"
            y="3">draft to the writer · skill never publishes</text
          ></g
        >
      </g>

      <!-- Nodes -->
      <g class="ba-node source">
