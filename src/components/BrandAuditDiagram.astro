          marker-end="url(#ba-arrow)"></path>

        <path class="ba-edge" d="M477 88 V102" marker-end="url(#ba-arrow)"
        ></path>
        <path class="ba-edge" d="M477 142 V156" marker-end="url(#ba-arrow)"
        ></path>
        <path class="ba-edge" d="M477 196 V210" marker-end="url(#ba-arrow)"
        ></path>

        <!-- Rule-set outputs collected on a bus into the report -->
        <path class="ba-edge" d="M552 68 H572"></path>
        <path class="ba-edge" d="M552 122 H572"></path>
        <path class="ba-edge" d="M552 176 H572"></path>
