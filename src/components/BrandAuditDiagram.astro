<figure class="ba-fig">
  <figcaption>
    <span>Architecture diagram</span>
  </figcaption>

  <div class="ba-scroll">
    <svg viewBox="0 0 1080 394" role="img" aria-labelledby="ba-title ba-desc">
      <title id="ba-title">Brand unification skill audit flow</title>
      <desc id="ba-desc">
        A user in Claude Desktop pastes a URL, document, PDF, or deck and asks
        Claude to audit it. That loads the brand skill, which uses progressive
        disclosure to read only the rule files each step needs. The content
        passes through four ordered rule sets — brand remediation, tone and
        voice, content rewrite, and escalation — each scoring it against a
        rubric. The skill returns an audit report with a score per rubric and a
        rewritten draft, then routes the finding to the content team for
        in-scope fixes or to legal when it needs review. The draft returns to
        the writer, who makes the change; the skill never publishes.
      </desc>

      <defs>
        <marker
          id="ba-arrow"
          markerWidth="9"
          markerHeight="9"
          refX="8"
          refY="4.5"
          orient="auto"
        >
          <path class="ba-arrow" d="M0 0 L9 4.5 L0 9 Z"></path>
        </marker>
        <marker
          id="ba-arrow-return"
          markerWidth="9"
          markerHeight="9"
          refX="8"
          refY="4.5"
          orient="auto"
        >
          <path class="ba-arrow return" d="M0 0 L9 4.5 L0 9 Z"></path>
        </marker>
      </defs>

      <!-- Boundary: the skill and its rules -->
      <rect class="ba-boundary" x="194" y="24" width="372" height="248" rx="6"
      ></rect>
      <text class="ba-boundary-label" x="210" y="42"
        >SKILL · RULES + RUBRICS</text
      >

      <!-- Edges (drawn before nodes) -->
