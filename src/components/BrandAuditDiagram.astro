        <text class="t" x="971" y="117" text-anchor="middle">Content team</text>
        <text class="s" x="971" y="133" text-anchor="middle"
          >creative services</text
        >
      </g>
      <g class="ba-node route">
        <rect x="896" y="210" width="150" height="48" rx="6"></rect>
        <text class="t" x="971" y="231" text-anchor="middle">Legal</text>
        <text class="s" x="971" y="247" text-anchor="middle"
          >brand &amp; IP</text
