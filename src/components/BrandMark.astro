---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 110 62"
  fill="none"
  role="img"
  aria-labelledby="brand-mark-title"
>
  <title id="brand-mark-title">From Test to Trust</title>
  <path
    d="M56 18V4H4V30H42"
    stroke="rgb(var(--accent))"
    stroke-width="5"
    stroke-linecap="square"
    stroke-linejoin="miter"></path>
  <path
    d="M68 32H106V58H54V44"
    stroke="rgb(var(--foreground))"
    stroke-width="5"
    stroke-linecap="square"
    stroke-linejoin="miter"></path>
  <text
    x="27"
    y="21"
    fill="rgb(var(--foreground))"
    font-family="Inter, sans-serif"
    font-size="8"
    font-weight="700"
    text-anchor="middle"
    letter-spacing="1">TEST</text
  >
  <text
    x="81"
    y="49"
    fill="rgb(var(--accent))"
    font-family="Inter, sans-serif"
    font-size="7.5"
    font-weight="700"
    text-anchor="middle"
    letter-spacing=".6">TRUST</text
  >
</svg>
