---
import { siteConfig } from '../data/site-config';

const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<dialog
  id="connect-modal"
  class="connect-dialog"
  aria-labelledby="connect-modal-title"
>
  <div class="connect-dialog-panel">
    <header class="connect-dialog-header">
      <div class="connect-title-wrap">
        <span class="connect-dot" aria-hidden="true"></span>
        <h2 id="connect-modal-title" class="connect-title">Send a message</h2>
      </div>
      <button
        type="button"
        class="connect-close"
        data-close-connect
        aria-label="Close modal"
      >
        <span aria-hidden="true">✕</span>
      </button>
    </header>

    <form
      id="connect-form"
      class="connect-form"
      data-email={siteConfig.email}
      data-access-key={web3FormsKey}
    >
      <div class="connect-field-grid">
        <label class="connect-field">
          <span class="connect-label">Name</span>
          <input
            type="text"
            name="name"
            required
            autocomplete="name"
            placeholder="Your name"
            class="connect-input"
          />
        </label>

        <label class="connect-field">
          <span class="connect-label">Email</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
            class="connect-input"
          />
        </label>
      </div>

      <label class="connect-field">
        <span class="connect-label">Message</span>
        <textarea
          name="message"
          rows="4"
          required
          placeholder="How can we collaborate?"
          class="connect-input connect-textarea"></textarea>
      </label>

      <p id="connect-status" class="connect-status" role="status" hidden></p>

      <footer class="connect-footer">
        <button
          type="button"
          id="copy-email-btn"
          class="connect-email-badge"
          data-email={siteConfig.email}
          title="Copy email address"
        >
          <span id="copy-email-label">{siteConfig.email}</span>
          <span aria-hidden="true">⧉</span>
        </button>

        <button type="submit" id="connect-submit-btn" class="connect-submit">
          <span id="connect-submit-label">Send Message</span>
          <span class="connect-submit-arrow" aria-hidden="true">→</span>
        </button>
      </footer>
    </form>
  </div>
</dialog>

<style>
  .connect-dialog {
    width: min(92vw, 540px);
    margin: auto;
    padding: 0;
    border: 1px solid rgb(var(--line));
    border-radius: 12px;
    background: rgb(var(--surface));
    color: rgb(var(--foreground));
    box-shadow: 0 24px 56px rgb(0 0 0 / 0.38);
    opacity: 0;
    transform: translateY(8px) scale(0.985);
    transition:
      opacity 180ms ease-out,
      transform 180ms ease-out,
      overlay 180ms ease-out allow-discrete,
      display 180ms ease-out allow-discrete;
  }

  .connect-dialog[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @starting-style {
    .connect-dialog[open] {
      opacity: 0;
      transform: translateY(8px) scale(0.985);
    }
  }

  .connect-dialog::backdrop {
    background: rgb(15 12 10 / 0.65);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition:
      opacity 180ms ease-out,
      overlay 180ms ease-out allow-discrete,
      display 180ms ease-out allow-discrete;
  }

  .connect-dialog[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .connect-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  .connect-dialog-panel {
    padding: 26px 28px;
  }

  .connect-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgb(var(--line));
  }

  .connect-title-wrap {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .connect-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: rgb(var(--accent));
    flex-shrink: 0;
  }

  .connect-title {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.016em;
    color: rgb(var(--foreground));
  }

  .connect-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid rgb(var(--line));
    border-radius: 6px;
    background: rgb(var(--canvas));
    color: rgb(var(--muted-text));
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }

  .connect-close:hover {
    border-color: rgb(var(--accent));
    color: rgb(var(--accent));
  }

  .connect-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 18px;
  }

  .connect-field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .connect-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .connect-label {
    font: 600 11px / 1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--muted-text));
  }

  .connect-input {
    width: 100%;
    padding: 10px 13px;
    border: 1px solid rgb(var(--line));
    border-radius: 7px;
    background: rgb(var(--canvas));
    color: rgb(var(--foreground));
    font: 400 14.5px / 1.45 var(--font-sans);
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .connect-input::placeholder {
    color: rgb(var(--faint-text) / 0.65);
  }

  .connect-input:focus {
    outline: none;
    border-color: rgb(var(--accent));
    box-shadow: 0 0 0 2px rgb(var(--accent) / 0.2);
  }

  .connect-input:user-invalid {
    border-color: #e06c58;
  }

  .connect-textarea {
    resize: vertical;
    min-height: 104px;
  }

  .connect-status {
    margin: 0;
    padding: 10px 14px;
    border-radius: 6px;
    border: 1px solid rgb(var(--accent) / 0.4);
    background: rgb(var(--accent) / 0.1);
    color: rgb(var(--foreground));
    font: 500 12.5px / 1.45 var(--font-mono);
  }

  .connect-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid rgb(var(--line));
  }

  .connect-email-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: rgb(var(--surface-raised));
    color: rgb(var(--muted-text));
    font: 500 11.5px / 1.2 var(--font-mono);
    cursor: pointer;
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }

  .connect-email-badge:hover {
    border-color: rgb(var(--accent) / 0.6);
    color: rgb(var(--accent));
  }

  .connect-submit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1px solid rgb(var(--accent));
    border-radius: 5px;
    background: rgb(var(--accent));
    color: #fff;
    font: 600 12px / 1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 180ms ease-out,
      color 180ms ease-out;
  }

  .connect-submit:hover {
    background: transparent;
    color: rgb(var(--accent));
  }

  .connect-submit-arrow {
    display: inline-block;
    font-size: 16px;
    line-height: 1;
    transform: translateY(-0.5px);
  }

  @media (max-width: 560px) {
    .connect-dialog-panel {
      padding: 22px 20px;
    }
    .connect-field-grid {
      grid-template-columns: 1fr;
    }
    .connect-footer {
      flex-direction: column;
      align-items: stretch;
    }
    .connect-submit {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .connect-dialog,
    .connect-dialog::backdrop,
    .connect-close,
    .connect-input,
    .connect-email-badge,
    .connect-submit {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.querySelector<HTMLDialogElement>('#connect-modal');
    const form = document.querySelector<HTMLFormElement>('#connect-form');
    const statusEl = document.querySelector<HTMLElement>('#connect-status');
    const submitLabel = document.querySelector<HTMLElement>(
      '#connect-submit-label',
    );
    const copyBtn =
      document.querySelector<HTMLButtonElement>('#copy-email-btn');
    const copyLabel = document.querySelector<HTMLElement>('#copy-email-label');

    if (!dialog || !form) return;

    document.querySelectorAll('[data-open-connect]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        if (statusEl) statusEl.hidden = true;
        dialog.showModal();
      });
    });

    document.querySelectorAll('[data-close-connect]').forEach((btn) => {
      btn.addEventListener('click', () => dialog.close());
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });

    copyBtn?.addEventListener('click', async () => {
      const email = copyBtn.dataset.email ?? '';
      if (!email || !copyLabel) return;
      try {
        await navigator.clipboard.writeText(email);
        copyLabel.textContent = 'Copied to clipboard ✓';
        setTimeout(() => {
          copyLabel.textContent = email;
        }, 2000);
      } catch {
        // Ignore clipboard errors if blocked
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      const accessKey = form.dataset.accessKey ?? '';
      const targetEmail = form.dataset.email ?? '';

      if (submitLabel) submitLabel.textContent = 'Sending...';
      if (statusEl) statusEl.hidden = true;

      try {
        const response = accessKey
          ? await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify({
                access_key: accessKey,
                subject: `[From Test to Trust] Message from ${name}`,
                from_name: name,
                email,
                message,
              }),
            })
          : await fetch(`https://formsubmit.co/ajax/${targetEmail}`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify({
                name,
                email,
                message,
                _subject: `[From Test to Trust] Message from ${name}`,
              }),
            });

        const result = await response.json().catch(() => null);
        const succeeded =
          response.ok &&
          result?.success !== 'false' &&
          result?.success !== false;

        if (succeeded) {
          if (statusEl) {
            statusEl.textContent =
              'Message sent! Thanks for reaching out — I will get back to you soon.';
            statusEl.hidden = false;
          }
          form.reset();
          setTimeout(() => dialog.close(), 2000);
        } else {
          if (statusEl) {
            statusEl.textContent =
              result?.message ||
              'Unable to send right now. Please copy my email below to reach out directly.';
            statusEl.hidden = false;
          }
        }
      } catch {
        if (statusEl) {
          statusEl.textContent =
            'Network error while sending. Please copy my email below to reach out directly.';
          statusEl.hidden = false;
        }
      } finally {
        if (submitLabel) submitLabel.textContent = 'Send Message';
      }
    });
  });
</script>
