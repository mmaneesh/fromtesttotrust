---
import { siteConfig } from '../data/site-config';
---

<footer
  class="mx-auto w-full max-w-[980px] border-t border-line bg-canvas py-6 mt-auto"
>
  <div
    class="mx-auto flex flex-col items-center justify-between gap-3 px-4 sm:flex-row sm:px-7"
  >
    <div
      class="flex flex-col items-center sm:items-start text-center sm:text-left"
    >
      <div class="flex items-center gap-2">
        <span class="font-display font-bold text-white text-sm tracking-tight"
          >{siteConfig.brandName}</span
        >
        <span class="text-slate-500 text-xs">/</span>
        <span class="text-xs font-mono text-accent">{siteConfig.name}</span>
      </div>
      <p class="text-xs text-slate-400 mt-1 font-mono">
        {siteConfig.role} · {siteConfig.employer}
      </p>
    </div>

    <div class="flex items-center gap-4 text-xs font-mono text-slate-400">
      <a
        href="https://www.linkedin.com/in/maneesh-maddala/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent transition-colors"
      >
        LinkedIn
      </a>
      <span>·</span>
      <a
        href="https://github.com/mmaneesh"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent transition-colors"
      >
        GitHub
      </a>
    </div>
  </div>
</footer>
