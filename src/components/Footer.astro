---
import { siteConfig } from '../data/site-config';
---

<footer class="w-full border-t border-line bg-canvas py-7 mt-auto">
  <div
    class="mx-auto flex max-w-[1440px] flex-col items-center justify-between gap-4 px-4 sm:flex-row sm:px-8 lg:px-12"
  >
    <div
      class="flex flex-col items-center sm:items-start text-center sm:text-left"
    >
      <div class="flex items-baseline gap-2.5">
        <span
          class="font-editorial font-medium text-foreground text-[18px] tracking-tight"
          >{siteConfig.brandName}</span
        >
        <span class="text-faint text-xs">/</span>
        <span class="text-[13px] font-mono font-medium text-accent"
          >{siteConfig.name}</span
        >
      </div>
      <p class="text-[13px] text-muted mt-1 font-mono">
        {siteConfig.role} · {siteConfig.employer}
      </p>
    </div>

    <div
      class="flex items-center gap-5 text-[13px] font-mono font-medium text-muted"
    >
      <a
        href="https://www.linkedin.com/in/maneesh-maddala/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 hover:text-accent transition-colors"
      >
        <span>LinkedIn</span>
        <svg
          class="h-3.5 w-3.5 shrink-0 opacity-80"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9.5 2.5h4v4"></path>
          <path d="M13.5 2.5L7.5 8.5"></path>
          <path
            d="M11.5 9v3.25a1.25 1.25 0 0 1-1.25 1.25h-6.5A1.25 1.25 0 0 1 2.5 12.25v-6.5A1.25 1.25 0 0 1 3.75 4.5H7"
          ></path>
        </svg>
      </a>
      <span class="text-line">·</span>
      <a
        href="https://github.com/mmaneesh"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 hover:text-accent transition-colors"
      >
        <span>GitHub</span>
        <svg
          class="h-3.5 w-3.5 shrink-0 opacity-80"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9.5 2.5h4v4"></path>
          <path d="M13.5 2.5L7.5 8.5"></path>
          <path
            d="M11.5 9v3.25a1.25 1.25 0 0 1-1.25 1.25h-6.5A1.25 1.25 0 0 1 2.5 12.25v-6.5A1.25 1.25 0 0 1 3.75 4.5H7"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
