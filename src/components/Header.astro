---
import { siteConfig } from '../data/site-config';
import BrandMark from './BrandMark.astro';
import ConnectModal from './ConnectModal.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="w-full sticky top-0 z-40 bg-canvas border-b border-line">
  <div
    class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 h-16 flex items-center justify-between"
  >
    <a
      href="/"
      class="inline-flex focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
      aria-label="From Test to Trust"
    >
      <BrandMark class="w-[100px] h-auto" />
    </a>
    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href={`mailto:${siteConfig.email}`}
        data-open-connect
        aria-haspopup="dialog"
        aria-controls="connect-modal"
        class="inline-flex items-center gap-2 border border-accent rounded-[4px] bg-accent px-4 py-2 text-[12px] font-mono font-semibold uppercase tracking-[0.08em] text-white transition-colors duration-180 hover:bg-transparent hover:text-accent"
      >
        Connect <span
          aria-hidden="true"
          class="inline-block text-[16px] leading-none -translate-y-[0.5px]"
          >→</span
        >
      </a>
    </div>
  </div>
</header>
<ConnectModal />
