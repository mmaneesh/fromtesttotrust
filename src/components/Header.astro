---
import { siteConfig } from '../data/site-config';
import BrandMark from './BrandMark.astro';
---

<header
  class="w-full border-b border-white/[0.06] bg-[#070A0F]/80 backdrop-blur-md sticky top-0 z-40"
>
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2 sm:gap-4"
  >
    <!-- Brand / Name Identity -->
    <a
      href="/"
      class="flex items-center gap-2 sm:gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-accent rounded-lg p-1 shrink-0"
    >
      <BrandMark class="w-[76px] h-11 sm:w-[86px] sm:h-12 shrink-0" />
      <div class="hidden sm:flex flex-col">
        <span
          class="text-xs sm:text-base font-display font-bold text-white tracking-tight"
        >
          From Test to <span class="text-cyan-accent">Trust</span>
        </span>
        <span
          class="hidden sm:block mt-1 text-[9px] font-mono font-medium uppercase tracking-[0.24em] text-slate-400"
        >
          {siteConfig.name}
        </span>
      </div>
    </a>

    <!-- Top Links & Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href="https://www.linkedin.com/in/maneesh-maddala/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono text-slate-300 hover:text-white bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.08] hover:border-white/20 transition-all duration-150"
        aria-label="Maneesh Maddala on LinkedIn"
      >
        <svg
          class="w-3.5 h-3.5 text-cyan-accent"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.2a1.64 1.64 0 1 0 1.64 1.63A1.64 1.64 0 0 0 7.83 6.2Z"
          ></path>
        </svg>
        <span class="hidden sm:inline">LinkedIn</span>
      </a>

      <a
        href="https://github.com/mmaneesh"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono text-slate-300 hover:text-white bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.08] hover:border-white/20 transition-all duration-150"
        aria-label="Maneesh Maddala on GitHub"
      >
        <svg
          class="w-3.5 h-3.5 text-slate-300"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2Z"
          ></path>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>

      <a
        href="mailto:maneesh.maddala@gmail.com"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono text-slate-300 hover:text-white bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.08] hover:border-white/20 transition-all duration-150"
        aria-label="Email Maneesh Maddala at maneesh.maddala@gmail.com"
      >
        <svg
          class="w-3.5 h-3.5 text-cyan-accent"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        <span class="hidden sm:inline">Email</span>
      </a>
    </div>
  </div>
</header>
