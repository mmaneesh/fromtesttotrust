---
interface Props {
  value: string;
  label?: string;
  context?: string;
}

const { value, label, context } = Astro.props;
---

<div
  class="group relative inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono bg-emerald-accent/10 text-emerald-300 border border-emerald-accent/25 hover:border-emerald-accent/50 hover:bg-emerald-accent/15 transition-all duration-200 cursor-default"
>
  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
  <span class="font-semibold text-emerald-200">{value}</span>
  {
    label && (
      <span class="text-emerald-400/80 text-[11px] hidden sm:inline">
        · {label}
      </span>
    )
  }

  {
    context && (
      <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 p-2.5 rounded-lg bg-surface-hover border border-white/15 text-[11px] font-sans text-slate-200 shadow-xl pointer-events-none z-50">
        {context}
        <div class="absolute top-full left-1/2 -translate-x-1/2 -mt-1 border-4 border-transparent border-t-surface-hover" />
      </div>
    )
  }
</div>
