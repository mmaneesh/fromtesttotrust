---
import { siteConfig } from '../data/site-config';

const linkedIn = siteConfig.socials.find((social) => social.id === 'linkedin');
const github = siteConfig.socials.find((social) => social.id === 'github');
---

<div class="relative border-b border-line pb-5 md:border-b-0 md:pb-0">
  <div class="flex items-start gap-4 md:flex-col md:gap-4">
    <img
      src="/images/maneesh-portrait-2026.png"
      alt="Maneesh Maddala"
      width="104"
      height="104"
      class="h-20 w-20 shrink-0 rounded-2xl object-cover md:h-[104px] md:w-[104px]"
    />

    <div class="min-w-0">
      <h1
        class="font-display text-lg font-bold leading-tight tracking-tight text-foreground"
      >
        {siteConfig.name}
      </h1>
      <p class="mt-1 text-xs font-semibold leading-snug text-body">
        {siteConfig.role}
      </p>
      <p class="mt-1 text-xs leading-relaxed text-muted">
        {siteConfig.employer}
      </p>
    </div>
  </div>

  <p class="mt-2 text-[11px] leading-relaxed text-muted">
    {siteConfig.location}
  </p>

  <nav aria-label="Contact links" class="mt-2 flex items-center gap-1 md:mt-3">
    <a
      href={`mailto:${siteConfig.email}`}
      class="inline-flex h-11 w-11 items-center justify-center text-foreground transition-colors hover:text-accent"
      aria-label={`Email ${siteConfig.name}`}
      title="Email"
    >
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
      </svg>
    </a>
    {
      linkedIn && (
        <a
          href={linkedIn.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 w-11 items-center justify-center text-foreground transition-colors hover:text-accent"
          aria-label={`${siteConfig.name} on LinkedIn`}
          title="LinkedIn"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M6.5 8.3H3.3V19h3.2V8.3ZM4.9 3A1.9 1.9 0 1 0 5 6.8 1.9 1.9 0 0 0 4.9 3ZM20.7 12.9c0-3.2-1.7-4.8-4.1-4.8a3.6 3.6 0 0 0-3.3 1.8V8.3h-3.2V19h3.2v-5.3c0-1.4.3-2.8 2.1-2.8s1.9 1.6 1.9 2.9V19h3.2l.2-6.1Z" />
          </svg>
        </a>
      )
    }
    {
      github && (
        <a
          href={github.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 w-11 items-center justify-center text-foreground transition-colors hover:text-accent"
          aria-label={`${siteConfig.name} on GitHub`}
          title="GitHub"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5A3.9 3.9 0 0 1 6.6 8.7a3.6 3.6 0 0 1 .1-2.7s.8-.3 2.8 1a9.7 9.7 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1a3.6 3.6 0 0 1 .1 2.7 3.9 3.9 0 0 1 1 2.7c0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      )
    }
  </nav>
</div>
