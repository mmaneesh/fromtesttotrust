<figure class="si-fig">
  <figcaption>
    <span>Architecture diagram</span>
  </figcaption>

  <div class="si-scroll">
    <svg viewBox="0 0 1104 350" role="img" aria-labelledby="si-title si-desc">
      <title id="si-title">Support intake workflow architecture</title>
      <desc id="si-desc">
        Three sources — a support email mailbox, a Slack channel, and a Jira
        project — each fire a webhook that normalizes the request and posts it
        as one message into a single Microsoft Teams channel. A support engineer
        triages the channel and, on a genuine issue, runs the Support Intake
        Agent action on the message, which starts a Power Automate flow. The
        flow copies the requestor, description, and attachments into a new Asana
        task and assigns it to the team that owns that request type.
      </desc>

      <defs>
        <marker
          id="si-arrow"
          markerWidth="9"
          markerHeight="9"
          refX="8"
          refY="4.5"
          orient="auto"
        >
          <path class="si-arrow" d="M0 0 L9 4.5 L0 9 Z"></path>
        </marker>
        <marker
          id="si-arrow-action"
          markerWidth="9"
          markerHeight="9"
          refX="8"
          refY="4.5"
          orient="auto"
        >
          <path class="si-arrow action" d="M0 0 L9 4.5 L0 9 Z"></path>
        </marker>
      </defs>

      <!-- Boundary: Microsoft 365 / Power Platform -->
      <rect class="si-boundary" x="410" y="28" width="448" height="272" rx="6"
      ></rect>
      <text class="si-boundary-label" x="426" y="46"
        >MICROSOFT 365 · POWER PLATFORM</text
      >

      <!-- Edges (drawn before nodes) -->
      <g class="si-edge-group">
        <path class="si-edge" d="M162 78 H214" marker-end="url(#si-arrow)"
        ></path>
        <path class="si-edge" d="M162 166 H214" marker-end="url(#si-arrow)"
        ></path>
        <path class="si-edge" d="M162 254 H214" marker-end="url(#si-arrow)"
        ></path>

        <path class="si-edge" d="M346 78 H430" marker-end="url(#si-arrow)"
        ></path>
        <path class="si-edge" d="M346 166 H430" marker-end="url(#si-arrow)"
        ></path>
        <path class="si-edge" d="M346 254 H430" marker-end="url(#si-arrow)"
        ></path>

        <path
          class="si-edge action"
          d="M606 166 H678"
          marker-end="url(#si-arrow-action)"></path>
        <path class="si-edge" d="M846 166 H912" marker-end="url(#si-arrow)"
        ></path>
      </g>

      <!-- Human triage gate on the action edge -->
      <circle class="si-gate" cx="606" cy="166" r="5"></circle>

      <!-- Edge labels -->
      <g class="si-elabel">
        <g transform="translate(188,166)"
          ><rect x="-25" y="-9" width="50" height="16" rx="3"></rect><text
            text-anchor="middle"
            y="3">webhook</text
          ></g
        >
        <g transform="translate(388,166)"
          ><rect x="-34" y="-9" width="68" height="16" rx="3"></rect><text
            text-anchor="middle"
            y="3">one message</text
          ></g
        >
        <g transform="translate(642,150)"
          ><rect x="-30" y="-9" width="60" height="16" rx="3"></rect><text
            text-anchor="middle"
            y="3">run action</text
          ></g
        >
        <g transform="translate(879,166)"
          ><rect x="-31" y="-9" width="62" height="16" rx="3"></rect><text
            text-anchor="middle"
            y="3">create task</text
          ></g
        >
      </g>

      <!-- Nodes: sources -->
      <g class="si-node source">
        <rect x="16" y="52" width="146" height="52" rx="6"></rect>
        <text class="t" x="89" y="75" text-anchor="middle">Email</text>
        <text class="s" x="89" y="92" text-anchor="middle">support mailbox</text
        >
      </g>
      <g class="si-node source">
        <rect x="16" y="140" width="146" height="52" rx="6"></rect>
        <text class="t" x="89" y="163" text-anchor="middle">Slack</text>
        <text class="s" x="89" y="180" text-anchor="middle"
          >support channel</text
        >
      </g>
      <g class="si-node source">
        <rect x="16" y="228" width="146" height="52" rx="6"></rect>
        <text class="t" x="89" y="251" text-anchor="middle">Jira</text>
        <text class="s" x="89" y="268" text-anchor="middle"
          >support project</text
        >
      </g>

      <!-- Nodes: webhooks -->
      <g class="si-node hook">
        <rect x="214" y="52" width="132" height="52" rx="6"></rect>
        <text class="t" x="280" y="75" text-anchor="middle">Webhook</text>
        <text class="s" x="280" y="92" text-anchor="middle">normalize</text>
      </g>
      <g class="si-node hook">
        <rect x="214" y="140" width="132" height="52" rx="6"></rect>
        <text class="t" x="280" y="163" text-anchor="middle">Webhook</text>
        <text class="s" x="280" y="180" text-anchor="middle">normalize</text>
      </g>
      <g class="si-node hook">
        <rect x="214" y="228" width="132" height="52" rx="6"></rect>
        <text class="t" x="280" y="251" text-anchor="middle">Webhook</text>
        <text class="s" x="280" y="268" text-anchor="middle">normalize</text>
      </g>

      <!-- Node: Microsoft Teams queue -->
      <g class="si-node queue">
        <rect x="430" y="52" width="176" height="228" rx="6"></rect>
        <text class="t" x="518" y="150" text-anchor="middle"
          >Microsoft Teams</text
        >
        <text class="s" x="518" y="168" text-anchor="middle"
          >one intake channel</text
        >
        <text class="s" x="518" y="186" text-anchor="middle"
          >support engineer triages</text
        >
      </g>

      <!-- Node: Power Automate -->
      <g class="si-node flow">
        <rect x="678" y="130" width="168" height="72" rx="6"></rect>
        <text class="t" x="762" y="160" text-anchor="middle"
          >Power Automate</text
        >
        <text class="s" x="762" y="178" text-anchor="middle">intake flow</text>
      </g>

      <!-- Node: Asana -->
      <g class="si-node sink">
        <rect x="912" y="124" width="176" height="84" rx="6"></rect>
        <text class="t" x="1000" y="152" text-anchor="middle">Asana</text>
        <text class="s" x="1000" y="170" text-anchor="middle">task created</text
        >
        <text class="s" x="1000" y="187" text-anchor="middle"
          >routed to owning team</text
        >
      </g>

      <!-- Legend -->
      <g class="si-legend" transform="translate(16,326)">
        <line x1="0" y1="0" x2="30" y2="0" class="si-edge"></line>
        <text x="40" y="4">request flow</text>
        <line x1="170" y1="0" x2="200" y2="0" class="si-edge action"></line>
        <circle cx="185" cy="0" r="4" class="si-gate"></circle>
        <text x="210" y="4">manual action · human triage</text>
        <rect x="454" y="-8" width="22" height="16" rx="3" class="si-boundary"
        ></rect>
        <text x="486" y="4">Microsoft 365 · Power Platform</text>
      </g>
    </svg>
  </div>
</figure>

