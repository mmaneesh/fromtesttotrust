        <>
          <rect class="outline" x="20" y="22" width="84" height="32" rx="2" />
          <rect class="outline" x="20" y="62" width="84" height="32" rx="2" />
          <rect class="outline" x="20" y="102" width="84" height="32" rx="2" />
          <path
            class="muted"
            d="M32 34H92M32 44H92M32 74H92M32 84H92M32 114H92M32 124H92"
          />
        </>
        <path class="accent" d="M104 38L182 76M104 78H182M104 118L182 80" />
        <path class="accent" d="M192 78H248" />
        <>
          <circle class="dot" cx="104" cy="38" r="3.5" />
          <circle class="dot" cx="104" cy="78" r="3.5" />
          <circle class="dot" cx="104" cy="118" r="3.5" />
          <circle class="dot" cx="186" cy="78" r="6.5" />
        </>
        <rect class="outline" x="250" y="36" width="90" height="84" rx="2" />
        <path class="line" d="M262 54H328M262 72H328M262 90H328M262 108H306" />
        <>
