    )
  }
  {
    systemId === 'defect-triaging-agent' && (
      <svg viewBox="0 0 360 156" preserveAspectRatio="none">
        <rect class="outline" x="28" y="42" width="94" height="72" rx="2" />
        <rect class="outline" x="36" y="33" width="94" height="72" rx="2" />
        <rect class="outline" x="44" y="24" width="94" height="72" rx="2" />
        <path class="muted" d="M58 45H118M58 57H110M58 69H120" />
        <circle class="dot" cx="66" cy="87" r="4" />
