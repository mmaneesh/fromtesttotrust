        <circle class="dot" cx="191" cy="48" r="5" />
        <circle class="dot" cx="215" cy="48" r="5" />
        <circle class="dot" cx="239" cy="48" r="5" />
        <path class="line" d="M257 48H320" />
        <path
          class="accent"
          d="M172 111L196 96L216 104L238 80L262 88L286 61L320 70"
        />
        <text class="label" x="44" y="17">
          REPORT HISTORY
        </text>
        <text class="label" x="172" y="33">
          ERROR CLUSTER
        </text>
        <text class="label" x="44" y="137">
          RETRY EVENT
        </text>
        <text class="label" x="250" y="137">
          SLOWDOWN
        </text>
      </svg>
    )
  }
  {
    systemId === 'brand-unification-skill' && (
      <svg viewBox="0 0 360 156" preserveAspectRatio="none">
        <rect class="outline" x="34" y="32" width="86" height="64" rx="2" />
        <rect class="outline" x="82" y="60" width="86" height="64" rx="2" />
        <rect class="outline" x="130" y="18" width="86" height="64" rx="2" />
        <path class="muted" d="M44 50H104M92 78H152M140 36H200" />
        <path
          class="accent"
          d="M224 20V136M204 48H244M204 78H244M204 108H244"
        />
        <path class="line" d="M244 78H320M264 58H320M264 98H320" />
        <rect class="outline" x="264" y="48" width="60" height="60" rx="2" />
        <>
          <circle class="dot" cx="224" cy="48" r="5" />
          <circle class="dot" cx="224" cy="78" r="6" />
          <circle class="dot" cx="224" cy="108" r="5" />
          <circle class="dot" cx="294" cy="78" r="5" />
        </>
        <path class="check" d="M276 38L281 43L291 30" />
        <>
          <text class="label" x="42" y="20">
            INPUTS
          </text>
          <text class="label" x="201" y="151">
            ALIGN
          </text>
          <text class="label" x="270" y="128">
            SYSTEM
          </text>
        </>
      </svg>
    )
  }
</div>

<style>
  .system-illustration {
    --image-background: #eadfce;
    --image-ink: #40362e;
    --image-accent: #9f4938;
    --image-check: #047857;
    height: 156px;
    overflow: hidden;
    background: var(--image-background);
  }

  :global(:root[data-theme='light']) .system-illustration {
    --image-background: #3a302a;
    --image-ink: #eadfd2;
    --image-accent: #e48768;
    --image-check: #5ebb8d;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .line,
  .outline {
    fill: none;
    stroke: var(--image-ink);
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .muted {
    fill: none;
    stroke: var(--image-ink);
    stroke-width: 1.15;
    opacity: 0.7;
  }
  .accent {
    fill: none;
    stroke: var(--image-accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dot {
    fill: var(--image-accent);
  }
  .check {
    fill: none;
    stroke: var(--image-check);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .label {
    fill: var(--image-ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.13em;
  }
</style>
