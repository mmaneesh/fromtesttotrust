---
interface Props {
  name: string;
  size?: string;
}

const { name, size = 'w-7 h-7' } = Astro.props;
---

<div
  title={name}
  class={`${size} rounded-full bg-[#141B28] border border-white/10 flex items-center justify-center p-1.5 text-slate-300 hover:text-cyan-accent hover:border-cyan-accent/40 hover:bg-[#1A2334] transition-all shadow-sm shrink-0`}
>
  {
    name === 'openai' && (
      <svg
        class="w-full h-full text-emerald-400"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M22.28 9.87a5.98 5.98 0 0 0-.5-4.66 6.06 6.06 0 0 0-6.19-2.9 6.06 6.06 0 0 0-4.6-2.18 6.04 6.04 0 0 0-5.74 4.14 6.04 6.04 0 0 0-3.83 2.78 6.05 6.05 0 0 0 .74 6.78 5.98 5.98 0 0 0 .5 4.66 6.05 6.05 0 0 0 6.19 2.9 6.05 6.05 0 0 0 4.6 2.18 6.04 6.04 0 0 0 5.74-4.14 6.04 6.04 0 0 0 3.83-2.78 6.05 6.05 0 0 0-.74-6.78Z" />
      </svg>
    )
  }

  {
    name === 'python' && (
      <svg
        class="w-full h-full text-yellow-400"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M11.91 2c-5.09 0-4.78 2.21-4.78 2.21l.01 2.29h4.86v.69H5.16S2 6.83 2 11.93c0 5.09 2.76 4.92 2.76 4.92h1.65v-2.32s-.09-2.76 2.71-2.76h4.68v-.7H9.12s-2.7 0-2.7-2.61c0-2.61 2.34-2.53 2.34-2.53h5.83S17.2 6 17.2 3.63C17.2 1.25 11.91 2 11.91 2Z" />
        <path d="M12.09 22c5.09 0 4.78-2.21 4.78-2.21l-.01-2.29h-4.86v-.69h6.84S22 17.17 22 12.07c0-5.09-2.76-4.92-2.76-4.92h-1.65v2.32s.09 2.76-2.71 2.76H10.2v.7h4.68s2.7 0 2.7 2.61c0 2.61-2.34 2.53-2.34 2.53H9.41S6.8 18 6.8 20.37C6.8 22.75 12.09 22 12.09 22Z" />
      </svg>
    )
  }

  {
    name === 'typescript' && (
      <svg class="w-full h-full" viewBox="0 0 24 24" aria-hidden="true">
        <rect width="24" height="24" rx="2" fill="#3178C6" />
        <path
          d="M5 10h8M9 10v8M14.5 16.7c1.1 1.1 4.1 1.3 4.5-.5.5-2.3-4.6-1.6-4.2-4.6.2-2 3.3-2.4 4.5-.8"
          fill="none"
          stroke="#fff"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>
    )
  }

  {
    name === 'playwright' && (
      <svg class="w-full h-full" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M3.3 5.5c2.1 1 4.2 1.1 6.3.2.3 5.8-1 10.2-3.7 10.7-2.8.4-4.2-3.7-2.6-10.9Z"
          fill="#D65348"
        />
        <path
          d="M7.9 4.4c4.2 1.6 8.3 1.2 12.2-.9 1.5 8.7-1.3 15.1-6.1 15.7-4.8.6-7.4-5.4-6.1-14.8Z"
          fill="#2EAD33"
        />
        <path
          d="M11 9.3c.8.5 1.6.5 2.4 0M16.1 8.1c.8.5 1.6.5 2.4 0M11.5 13.3c1.4 1.3 3 1.5 4.8.5"
          fill="none"
          stroke="#fff"
          stroke-width="1.1"
          stroke-linecap="round"
        />
      </svg>
    )
  }

  {
    name === 'jira' && (
      <svg class="w-full h-full" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m12 2 7 7-7 7-7-7 7-7Z" fill="#2684FF" />
        <path d="m12 7 4 4-4 4-4-4 4-4Z" fill="#0052CC" />
        <path d="m12 16 4 4-4 2-4-2 4-4Z" fill="#2684FF" />
      </svg>
    )
  }

  {
    name === 'testrail' && (
      <svg class="w-full h-full" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m4 6 5-3 4 2.4-5 3L4 6Z" fill="#4CCB80" />
        <path d="m8 10 5-3 4 2.4-5 3L8 10Z" fill="#36B37E" />
        <path d="m12 14 5-3 4 2.4-5 3-4-2.4Z" fill="#22A06B" />
        <path d="m16 18 5-3v5l-5 2v-4Z" fill="#1F845A" />
      </svg>
    )
  }

  {
    name === 'aws' && (
      <svg class="w-full h-full" viewBox="0 0 24 24" aria-hidden="true">
        <text
          x="3"
          y="13"
          fill="#F8FAFC"
          font-family="Arial, sans-serif"
          font-size="9"
          font-weight="700"
        >
          aws
        </text>
        <path
          d="M5 16.5c4.2 2.5 9 2.7 13.8.5M17.4 15.6l2.3.1-.8 2.1"
          fill="none"
          stroke="#FF9900"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }

  {
    name === 'git' && (
      <svg class="w-full h-full" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m12 2 10 10-10 10L2 12 12 2Z" fill="#F05032" />
        <path
          d="M8 7.5 16.5 16M9.2 14.5V9.2h5.3"
          fill="none"
          stroke="#fff"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <circle cx="8" cy="7" r="1.4" fill="#fff" />
        <circle cx="9" cy="16" r="1.4" fill="#fff" />
        <circle cx="16.5" cy="16" r="1.4" fill="#fff" />
      </svg>
    )
  }

  {
    name === 'azure' && (
      <svg
        class="w-full h-full text-sky-400"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M13.48 2L5.87 13.84l4.98 3.52L22 22 13.48 2zM2 17.33l6.53-4.5-2.6-4.22L2 17.33z" />
      </svg>
    )
  }

  {
    name === 'litellm' && (
      <svg
        class="w-full h-full text-cyan-400"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="12" cy="12" r="9" />
        <path d="M8 12h8M12 8l4 4-4 4" />
      </svg>
    )
  }

  {
    name === 'docker' && (
      <svg
        class="w-full h-full text-blue-400"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M13.98 10.02h2.04v2.04h-2.04zm-3 0h2.04v2.04h-2.04zm-3 0h2.04v2.04H7.98zm-3 0h2.04v2.04H4.98zm9-3h2.04v2.04h-2.04zm-3 0h2.04v2.04h-2.04zm-3 0h2.04v2.04H7.98zm9-3h2.04v2.04h-2.04zm-3 0h2.04v2.04h-2.04zM22.5 13c-.35 0-.7.05-1.02.15-.35-.74-.95-1.32-1.7-1.65-.2-.1-.4-.15-.6-.18l-.5-.07-.3.4c-.6.8-1.5 1.35-2.5 1.35H2.5c-.8 0-1.5.7-1.5 1.5 0 3.6 2.9 6.5 6.5 6.5 4.5 0 8.3-3 9.4-7.2.5.2 1.1.2 1.6 0 .4-.1.7-.3 1-.6.3.3.7.5 1.1.5.8 0 1.4-.7 1.4-1.5 0-.8-.6-1.4-1.5-1.4z" />
      </svg>
    )
  }
</div>
