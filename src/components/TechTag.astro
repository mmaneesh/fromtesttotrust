---
interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<span
  class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-mono font-medium bg-white/[0.04] text-slate-300 border border-white/[0.08] hover:border-cyan-accent/30 hover:text-white transition-colors duration-150"
>
  {tag}
</span>
