---
import BrandMark from './BrandMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../data/site-config';
const tabs = [
  { id: 'about', label: 'About', href: '/' },
  { id: 'experience', label: 'Experience', href: '/experience' },
  { id: 'ai-systems', label: 'AI Systems', href: '/ai-systems' },
  { id: 'speaking', label: 'Insights', href: '/speaking' },
];
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href;
---

<div class="view-switcher sticky top-0 z-30">
  <header class="topbar">
    <a class="brand" href="/" aria-label="From Test to Trust">
      <span class="brand-mark"><BrandMark /></span>
    </a>
    <nav id="primary-nav" aria-label="Portfolio sections">
      {
        tabs.map((tab) => (
          <a
            href={tab.href}
            aria-current={isActive(tab.href) ? 'page' : undefined}
            class:list={['nav-tab-btn', { active: isActive(tab.href) }]}
          >
            {tab.label}
          </a>
        ))
      }
    </nav>
    <div class="tools">
      <ThemeToggle /><a href={`mailto:${siteConfig.email}`} class="connect"
        >Connect <span aria-hidden="true">→</span></a
      >
    </div>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-controls="primary-nav"
      aria-expanded="false"
      ><svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
      ></button
    >
  </header>
</div>
<style>
  .view-switcher {
    background: rgb(var(--canvas));
    border-bottom: 1px solid rgb(var(--line));
  }
  .topbar {
    display: grid;
    max-width: 1024px;
    margin: 0 auto;
    padding: 0 28px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .brand-mark {
    display: block;
    width: 88px;
    flex: 0 0 88px;
  }
  .brand-mark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  #primary-nav {
    display: flex;
    gap: 24px;
  }
  .nav-tab-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    border: 0;
    background: transparent;
    color: rgb(var(--foreground));
    cursor: pointer;
    font:
      600 11px 'Geist Mono',
      monospace;
    letter-spacing: 0.08em;
    padding: 12px 0;
    text-decoration: none;
    text-transform: uppercase;
  }
  .nav-tab-btn.active,
  .nav-tab-btn:hover {
    color: rgb(var(--accent));
  }
  .nav-tab-btn.active::before {
    position: absolute;
    right: 0;
    left: 0;
    top: 6px;
    height: 2px;
    background: rgb(var(--accent));
    content: '';
  }
  .tools {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .connect {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid rgb(var(--accent));
    border-radius: 4px;
    background: rgb(var(--accent));
    color: #fff;
    font:
      500 10px 'Geist Mono',
      monospace;
    letter-spacing: 0.08em;
    padding: 9px 14px;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 180ms ease-out,
      border-color 180ms ease-out,
      color 180ms ease-out;
  }
  .connect:hover {
    background-color: transparent;
    color: rgb(var(--accent));
  }
  .connect span {
    font-size: 12px;
  }
  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    border: 0;
    padding: 0;
    background: transparent;
    color: rgb(var(--foreground));
    min-width: 44px;
    min-height: 44px;
  }
  .menu-toggle svg {
    width: 18px;
    height: 18px;
  }
  @media (max-width: 720px) {
    .topbar {
      grid-template-columns: 1fr auto auto;
      column-gap: 6px;
      min-height: 64px;
      padding: 0 16px;
    }
    .menu-toggle {
      display: inline-flex;
      grid-column: 3;
    }
    #primary-nav {
      display: flex;
      position: absolute;
      top: calc(100% + 1px);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      padding: 0 16px;
      pointer-events: none;
      transform: translateY(-6px);
      background: rgb(var(--canvas));
      border-bottom: 1px solid transparent;
      transition:
        max-height 220ms ease,
        opacity 160ms ease,
        padding 220ms ease,
        transform 220ms ease,
        border-color 160ms ease;
    }
    .topbar.menu-open #primary-nav {
      max-height: 240px;
      opacity: 1;
      padding: 8px 16px 12px;
      pointer-events: auto;
      transform: translateY(0);
      border-bottom-color: rgb(var(--line));
    }
    .tools {
      grid-column: 2;
      gap: 6px;
    }
    .nav-tab-btn {
      min-height: 44px;
      padding: 0 2px;
      text-align: left;
      font-size: 12px;
      font-weight: 500;
    }
    .connect {
      min-height: 32px;
      gap: 4px;
      padding: 6px 9px;
      font-size: 10px;
      font-weight: 600;
    }
    .connect span {
      font-size: 10px;
    }
    .menu-toggle {
      min-width: 36px;
      min-height: 36px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #primary-nav,
    .connect {
      transition: none;
    }
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const h = document.querySelector<HTMLElement>('.topbar');
    const m = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const n = document.querySelector<HTMLElement>('#primary-nav');
    const isCompact = () => window.matchMedia('(max-width: 720px)').matches;
    const setMenuOpen = (open: boolean) => {
      h?.classList.toggle('menu-open', open);
      m?.setAttribute('aria-expanded', String(open));
      if (isCompact()) n?.toggleAttribute('inert', !open);
      else n?.removeAttribute('inert');
    };
    const closeMenu = () => {
      setMenuOpen(false);
    };
    m?.addEventListener('click', () => {
      const o = !h?.classList.contains('menu-open');
      setMenuOpen(o);
    });
    document.addEventListener('click', (event) => {
      if (
        !h?.classList.contains('menu-open') ||
        !(event.target instanceof Node) ||
        m?.contains(event.target)
      ) {
        return;
      }
      closeMenu();
    });
    window.addEventListener('resize', closeMenu);
    closeMenu();
  });
</script>
