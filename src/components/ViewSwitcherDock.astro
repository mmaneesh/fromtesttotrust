---
import ThemeToggle from './ThemeToggle.astro';

const tabs = [
  { id: 'about', label: 'About' },
  { id: 'career', label: 'Experience' },
  { id: 'ai-systems', label: 'AI Systems' },
  { id: 'speaking', label: 'Speaking' },
];
---

<div class="view-switcher sticky top-0 z-30">
  <nav
    aria-label="Portfolio sections"
    class="flex h-12 min-w-0 items-center border-b border-line"
  >
    <div
      role="tablist"
      aria-label="View navigation"
      class="flex min-w-0 flex-1 justify-between gap-0 overflow-hidden sm:justify-start sm:gap-3"
    >
      {
        tabs.map((tab, index) => (
          <button
            id={`tab-${tab.id}`}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`view-${tab.id}`}
            data-target={`view-${tab.id}`}
            tabindex={index === 0 ? '0' : '-1'}
            class:list={[
              'nav-tab-btn relative h-12 shrink-0 border-b-2 border-transparent px-1 text-[10px] font-semibold text-muted transition-colors hover:text-foreground focus:outline-none sm:px-2.5 sm:text-[11px]',
              { active: index === 0 },
            ]}
          >
            {tab.label}
          </button>
        ))
      }
    </div>
    <div class="ml-2 shrink-0 sm:ml-auto sm:pl-3"><ThemeToggle /></div>
  </nav>
</div>

<style>
  .view-switcher {
    isolation: isolate;
    background-color: rgb(var(--canvas));
    box-shadow: 0 10px 14px -14px rgb(var(--foreground) / 0.35);
  }

  .nav-tab-btn.active {
    border-bottom-color: rgb(var(--accent));
    color: rgb(var(--foreground));
  }
</style>

<script>
  function setupTabs() {
    const tabButtons =
      document.querySelectorAll<HTMLButtonElement>('.nav-tab-btn');
    const views = document.querySelectorAll<HTMLElement>('.portfolio-view');

    function activateTab(targetId: string, updateHash = true) {
      tabButtons.forEach((btn) => {
        const isMatch = btn.dataset.target === targetId;
        btn.classList.toggle('active', isMatch);
        btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        btn.setAttribute('tabindex', isMatch ? '0' : '-1');
      });

      views.forEach((view) => {
        const isMatch = view.id === targetId;
        view.classList.toggle('hidden', !isMatch);
        if (isMatch) view.classList.add('animate-fade-in');
      });

      if (updateHash)
        history.replaceState(null, '', `#${targetId.replace('view-', '')}`);
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.target) activateTab(btn.dataset.target);
      });

      btn.addEventListener('keydown', (event) => {
        let index = Array.from(tabButtons).indexOf(btn);
        if (event.key === 'ArrowRight') index = (index + 1) % tabButtons.length;
        else if (event.key === 'ArrowLeft')
          index = (index - 1 + tabButtons.length) % tabButtons.length;
        else return;

        event.preventDefault();
        tabButtons[index].focus();
        tabButtons[index].click();
      });
    });

    const hash = window.location.hash.replace('#', '');
    const matchingBtn = document.querySelector<HTMLButtonElement>(
      `[data-target="view-${hash}"]`,
    );
    if (matchingBtn) activateTab(`view-${hash}`, false);
  }

  document.addEventListener('DOMContentLoaded', setupTabs);
</script>
