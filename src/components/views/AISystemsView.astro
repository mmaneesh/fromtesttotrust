---
import { aiSystems } from '../../data/ai-systems';
---

<section
  id="view-ai-systems"
  role="tabpanel"
  aria-labelledby="tab-ai-systems"
  class="portfolio-view hidden w-full py-4 sm:py-6"
>
  <header class="mb-8 max-w-[720px]">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
      Selected work
    </p>
    <h2 class="mt-2 font-editorial text-3xl font-medium text-foreground">
      AI systems
    </h2>
    <p class="mt-2 text-sm leading-6 text-muted">
      Production systems for evaluation, governance, routing, and test
      automation.
    </p>
  </header>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    {
      aiSystems.map((system) => (
        <article class="interactive-spotlight-card group relative rounded-2xl bg-[#0B0F19] border border-white/[0.08] hover:border-accent/60 p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:shadow-glow-accent">
          <div>
            <p class="text-[11px] font-mono font-semibold uppercase tracking-wider text-accent mb-3">
              {system.category}
            </p>

            <a href={`/systems/${system.id}`} class="group/title block">
              <h3 class="font-editorial text-2xl font-medium leading-snug text-foreground transition-colors group-hover/title:text-accent">
                {system.title}
              </h3>
            </a>

            <p class="text-xs font-mono text-slate-400 mb-3">
              {system.subtitle}
            </p>

            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
              {system.summary}
            </p>
          </div>

          <div>
            <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
              <a
                href={`/systems/${system.id}`}
                class="inline-flex items-center gap-1.5 font-semibold text-accent hover:text-accent hover:underline"
              >
                <span>View brief</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
