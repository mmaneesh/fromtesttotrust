---
import { aiSystems } from '../../data/ai-systems';
---

<section
  id="view-ai-systems"
  role="tabpanel"
  aria-labelledby="tab-ai-systems"
  class="portfolio-view hidden w-full py-8 sm:py-9"
>
  <header class="mb-7 max-w-[640px]">
    <h2 class="font-editorial text-[28px] font-medium text-foreground">
      AI systems
    </h2>
    <p class="mt-2 text-[13px] leading-[1.65] text-muted">
      Production systems for evaluation, governance, routing, and test
      automation.
    </p>
  </header>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      aiSystems.map((system) => (
        <article class="group relative flex flex-col justify-between rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent/60">
          <div>
            <p class="mb-2 text-[9px] font-bold uppercase tracking-[0.1em] text-accent">
              {system.category}
            </p>

            <a href={`/systems/${system.id}`} class="group/title block">
              <h3 class="font-editorial text-xl font-medium leading-snug text-foreground transition-colors group-hover/title:text-accent">
                {system.title}
              </h3>
            </a>

            <p class="mb-3 mt-1 text-[11px] leading-relaxed text-muted">
              {system.subtitle}
            </p>

            <p class="mb-5 text-xs leading-[1.65] text-body">
              {system.summary}
            </p>
          </div>

          <div>
            <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
              <a
                href={`/systems/${system.id}`}
                class="inline-flex items-center gap-1.5 font-semibold text-accent hover:text-accent hover:underline"
              >
                <span>View brief</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
