---
import { aiSystems } from '../../data/ai-systems';
import TechIcon from '../TechIcon.astro';
import TechTag from '../TechTag.astro';

// Map technologies to icon keys
const getIconKeys = (techs: string[]) => {
  const map: Record<string, string> = {
    TypeScript: 'typescript',
    Playwright: 'playwright',
    'Azure DevOps': 'azure',
    LiteLLM: 'litellm',
    Python: 'python',
    Docker: 'docker',
    AWS: 'aws',
    'LLM Evals': 'openai',
  };
  return techs.map((t) => map[t]).filter(Boolean);
};
---

<section
  id="view-ai-systems"
  role="tabpanel"
  aria-labelledby="tab-ai-systems"
  class="portfolio-view hidden max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6"
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      aiSystems.map((system) => {
        const icons = getIconKeys(system.technologies);
        return (
          <article class="interactive-spotlight-card group relative rounded-2xl bg-[#0B0F19] border border-white/[0.08] hover:border-cyan-400/60 p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:shadow-[0_0_30px_-5px_rgba(56,189,248,0.25)]">
            <div>
              <div class="flex items-center gap-2 mb-4">
                <TechIcon name="openai" size="w-7 h-7" />
                <TechIcon name="python" size="w-7 h-7" />
                <TechIcon name="typescript" size="w-7 h-7" />
                <TechIcon name="playwright" size="w-7 h-7" />
                <TechIcon name="azure" size="w-7 h-7" />
                {icons.includes('aws') && (
                  <TechIcon name="aws" size="w-7 h-7" />
                )}
                {icons.includes('litellm') && (
                  <TechIcon name="litellm" size="w-7 h-7" />
                )}
              </div>

              <div class="space-y-2 mb-5">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-mono bg-cyan-500/[0.08] text-cyan-200 border border-cyan-500/20">
                  <span class="text-cyan-400 font-bold">✓</span>
                  <span>Protected 20% Campaign Pipeline</span>
                </div>
                <div class="block">
                  <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-mono bg-cyan-500/[0.08] text-cyan-200 border border-cyan-500/20">
                    <span class="text-cyan-400 font-bold">✓</span>
                    <span>50–60% Bot Detection & Data Integrity</span>
                  </div>
                </div>
              </div>

              <a href={`/systems/${system.id}`} class="group/title block">
                <h3 class="text-lg sm:text-xl font-display font-bold text-white group-hover/title:text-cyan-accent transition-colors leading-snug mb-1">
                  {system.title}
                </h3>
              </a>

              <p class="text-xs font-mono text-slate-400 mb-3.5">
                {system.subtitle}
              </p>

              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-5">
                {system.summary}
              </p>

              <div class="mb-5 space-y-1.5 rounded-xl bg-[#121824]/60 border border-white/[0.05] p-3.5">
                <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1 font-semibold">
                  Architecture Blueprint:
                </div>
                {system.architecture.map((item) => (
                  <div class="text-xs text-slate-300 flex items-start gap-2 leading-relaxed">
                    <span class="text-cyan-accent font-mono text-[11px] mt-0.5">
                      ↳
                    </span>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <div class="flex flex-wrap gap-1.5 mb-4">
                {system.technologies.map((tech) => (
                  <TechTag tag={tech} />
                ))}
              </div>

              <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
                <a
                  href={`/systems/${system.id}`}
                  class="inline-flex items-center gap-1.5 font-semibold text-cyan-accent hover:text-cyan-300 hover:underline"
                >
                  <span>Read System Brief</span>
                  <span>→</span>
                </a>

                {system.links && system.links.length > 0 && (
                  <a
                    href={system.links[0].url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 hover:text-white transition-colors text-[11px]"
                  >
                    <span>{system.links[0].label}</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
