---
import { aiSystems } from '../../data/ai-systems';
import SystemIllustration from '../SystemIllustration.astro';
---

<section class="w-full py-8 sm:py-10">
  <header class="mb-8">
    <h1 class="type-page-title text-foreground">AI systems</h1>
    <p class="type-lead mt-3">
      Production systems for evaluation, governance, routing, and test
      automation.
    </p>
  </header>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      aiSystems.map((system) => (
        <article class="group relative flex flex-col overflow-hidden rounded-xl border border-line bg-surface transition-colors hover:border-accent/60">
          <SystemIllustration systemId={system.id} />

          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <a href={`/ai-systems/${system.id}`} class="group/title block">
                <h2 class="type-h3 text-foreground transition-colors group-hover/title:text-accent">
                  {system.title}
                </h2>
              </a>

              <p class="type-body mb-6 mt-3 line-clamp-3 text-body">
                {system.blurb}
              </p>
            </div>

            <div class="pt-4 border-t border-line flex items-center justify-between flex-wrap gap-2 text-[15px] font-mono">
              <a
                href={`/ai-systems/${system.id}`}
                class="inline-flex items-center gap-1.5 font-semibold text-accent hover:text-accent hover:underline"
              >
                <span>View brief</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
