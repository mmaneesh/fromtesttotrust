---
import { careerTimeline, educationAndCredentials } from '../../data/career';
---

<section
  id="view-career"
  role="tabpanel"
  aria-labelledby="tab-career"
  class="portfolio-view hidden w-full py-4 sm:py-6"
>
  <header class="mb-8 max-w-[720px]">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
      15+ years
    </p>
    <h2 class="mt-2 font-editorial text-3xl font-medium text-foreground">
      Experience
    </h2>
    <p class="mt-2 text-sm leading-6 text-muted">
      Quality engineering and technical leadership across fintech, insurance,
      and enterprise platforms.
    </p>
  </header>

  <div class="space-y-6">
    {
      careerTimeline.map((company) => (
        <article
          class={`rounded-2xl bg-[#0B0F19] border ${company.isCurrent ? 'border-accent/40' : 'border-white/[0.08]'} p-5 sm:p-6 relative`}
        >
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-5 mb-6 border-b border-white/[0.08] gap-2">
            <div class="flex items-center gap-3">
              <div
                class={`h-2.5 w-2.5 rounded-full ${company.isCurrent ? 'bg-accent' : 'bg-slate-500'}`}
              />
              <div>
                <h3 class="font-editorial text-2xl font-medium text-foreground">
                  {company.company}
                </h3>
                <p class="text-xs font-mono text-slate-400 mt-0.5">
                  {company.location}
                </p>
              </div>
            </div>

            <div class="text-xs font-medium text-muted sm:text-right">
              {company.totalTenure}
            </div>
          </div>

          <div class="space-y-6">
            {company.roles.map((role, rIndex) => (
              <div
                class={`relative ${rIndex > 0 ? 'pt-6 border-t border-white/[0.05]' : ''}`}
              >
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-3">
                  <h4 class="text-base sm:text-lg font-display font-bold text-slate-100 flex items-center gap-2">
                    <span class="text-accent text-xs">▸</span>
                    <span>{role.title}</span>
                  </h4>
                  <span class="text-xs font-mono text-slate-400 font-medium">
                    {role.period}
                  </span>
                </div>

                <div class="space-y-2">
                  {role.highlights.map((highlight) => (
                    <div class="text-xs sm:text-sm text-slate-300 leading-relaxed flex items-start gap-2.5">
                      <span class="text-slate-500 font-mono text-xs mt-1 shrink-0">
                        •
                      </span>
                      <span>{highlight}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </article>
      ))
    }

    <article class="border-y border-line py-6">
      <h3 class="font-editorial text-2xl font-medium text-foreground">
        Education and certifications
      </h3>

      <div class="mt-5 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <div
            class="text-xs font-mono text-accent uppercase tracking-wider mb-1 font-semibold"
          >
            Degree
          </div>
          <div class="text-sm font-semibold text-white mb-0.5">
            {educationAndCredentials.education.degree}
          </div>
          <div class="text-xs font-mono text-slate-400">
            {educationAndCredentials.education.institution} · {
              educationAndCredentials.education.period
            }
          </div>
        </div>

        <div>
          <div
            class="text-xs font-mono text-accent uppercase tracking-wider mb-2 font-semibold"
          >
            Certifications
          </div>
          <div class="flex flex-wrap gap-1.5">
            {
              educationAndCredentials.certifications.map((cert) => (
                <span class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-white/[0.04] text-slate-300 border border-white/[0.08]">
                  {cert}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
