---
import { careerTimeline, education } from '../../data/career';
---

<section class="w-full py-8 sm:py-10">
  <header class="mb-8">
    <h1 class="type-page-title text-foreground">Experience</h1>
    <p class="type-lead mt-3">
      More than 15 years in quality engineering and technical leadership across
      fintech, insurance, and enterprise platforms.
    </p>
  </header>

  <div class="space-y-6">
    {
      careerTimeline.map((company) => (
        <article class="rounded-xl border border-line bg-surface p-7 sm:p-8">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between pb-5 border-b border-line">
            <div class="flex items-center gap-3.5">
              <div
                class={`h-2.5 w-2.5 rounded-full ${company.isCurrent ? 'bg-accent' : 'bg-line'}`}
              />
              <div>
                <h2 class="type-h2 text-foreground">{company.company}</h2>
              </div>
            </div>
            <span class="text-xs font-mono px-2.5 py-1 rounded bg-surface-raised text-muted">
              {company.location}
            </span>
          </div>

          <div class="mt-6 space-y-7">
            {company.roles.map((role, rIndex) => (
              <div
                class={`relative ${rIndex > 0 ? 'border-t border-line pt-7' : ''}`}
              >
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4">
                  <h3 class="font-sans text-[19px] font-semibold text-foreground">
                    {role.title}
                  </h3>
                  <span class="text-[13px] font-mono text-accent font-semibold">
                    {role.period}
                  </span>
                </div>

                <ul class="space-y-2.5 pl-5">
                  {role.highlights
                    .slice(
                      0,
                      company.isCurrent && rIndex === 0
                        ? 4
                        : company.company === 'CSG'
                          ? 3
                          : 2,
                    )
                    .map((highlight) => (
                      <li class="type-body list-disc text-body marker:text-accent">
                        {highlight}
                      </li>
                    ))}
                </ul>
              </div>
            ))}
          </div>
        </article>
      ))
    }

    <article class="rounded-xl border border-line bg-surface p-7 sm:p-8">
      <div class="flex items-center justify-between pb-4 border-b border-line">
        <h2 class="type-h2 text-foreground">Education</h2>
        <span
          class="text-xs font-mono px-2.5 py-1 rounded bg-surface-raised text-muted"
        >
          {education.period}
        </span>
      </div>

      <div class="mt-5">
        <div class="type-label text-accent mb-1.5">Degree</div>
        <div class="text-[19px] font-semibold text-foreground mb-1">
          {education.degree}
        </div>
        <div class="text-[14px] font-mono text-muted">
          {education.institution}
        </div>
      </div>
    </article>
  </div>
</section>
