---
import { careerTimeline, educationAndCredentials } from '../../data/career';
---

<section
  id="view-career"
  role="tabpanel"
  aria-labelledby="tab-career"
  class="portfolio-view hidden w-full py-8 sm:py-9"
>
  <header class="mb-7 max-w-[640px]">
    <h2 class="font-editorial text-[28px] font-medium text-foreground">
      Experience
    </h2>
    <p class="mt-2 text-[13px] leading-[1.65] text-muted">
      More than 15 years in quality engineering and technical leadership across
      fintech, insurance, and enterprise platforms.
    </p>
  </header>

  <div class="border-t border-line">
    {
      careerTimeline.map((company) => (
        <article class="border-b border-line py-6">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
            <div class="flex items-center gap-3">
              <div
                class={`h-2.5 w-2.5 rounded-full ${company.isCurrent ? 'bg-accent' : 'bg-slate-500'}`}
              />
              <div>
                <h3 class="font-editorial text-xl font-medium text-foreground">
                  {company.company}
                </h3>
                <p class="text-xs font-mono text-slate-400 mt-0.5">
                  {company.location}
                </p>
              </div>
            </div>

            <div class="text-xs font-medium text-muted sm:text-right">
              {company.totalTenure}
            </div>
          </div>

          <div class="mt-5 space-y-5 sm:pl-5">
            {company.roles.map((role, rIndex) => (
              <div
                class={`relative ${rIndex > 0 ? 'border-t border-line pt-5' : ''}`}
              >
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-3">
                  <h4 class="text-sm font-semibold text-foreground sm:text-[15px]">
                    {role.title}
                  </h4>
                  <span class="text-xs font-mono text-slate-400 font-medium">
                    {role.period}
                  </span>
                </div>

                <ul class="space-y-1.5 pl-4">
                  {role.highlights
                    .slice(
                      0,
                      company.isCurrent && rIndex === 0
                        ? 4
                        : company.company === 'CSG'
                          ? 3
                          : 2,
                    )
                    .map((highlight) => (
                      <li class="list-disc text-xs leading-[1.65] text-body marker:text-accent">
                        {highlight}
                      </li>
                    ))}
                </ul>
              </div>
            ))}
          </div>
        </article>
      ))
    }

    <article class="border-b border-line py-6">
      <h3 class="font-editorial text-2xl font-medium text-foreground">
        Education and certifications
      </h3>

      <div class="mt-5 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <div
            class="text-xs font-mono text-accent uppercase tracking-wider mb-1 font-semibold"
          >
            Degree
          </div>
          <div class="text-sm font-semibold text-white mb-0.5">
            {educationAndCredentials.education.degree}
          </div>
          <div class="text-xs font-mono text-slate-400">
            {educationAndCredentials.education.institution} · {
              educationAndCredentials.education.period
            }
          </div>
        </div>

        <div>
          <div
            class="text-xs font-mono text-accent uppercase tracking-wider mb-2 font-semibold"
          >
            Certifications
          </div>
          <div class="flex flex-wrap gap-1.5">
            {
              educationAndCredentials.certifications.map((cert) => (
                <span class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-white/[0.04] text-slate-300 border border-white/[0.08]">
                  {cert}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
