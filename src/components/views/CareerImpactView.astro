---
import { careerTimeline, education } from '../../data/career';
---

<section class="w-full py-8 sm:py-9">
  <header class="mb-7 max-w-[640px]">
    <h1 class="font-editorial text-[28px] font-medium text-foreground">
      Experience
    </h1>
    <p class="mt-2 text-[13px] leading-[1.65] text-muted">
      More than 15 years in quality engineering and technical leadership across
      fintech, insurance, and enterprise platforms.
    </p>
  </header>

  <div>
    {
      careerTimeline.map((company) => (
        <article class="border-t-2 border-foreground py-6 first:border-t-0">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
            <div class="flex items-center gap-3">
              <div
                class={`h-2.5 w-2.5 rounded-full ${company.isCurrent ? 'bg-accent' : 'bg-slate-500'}`}
              />
              <div>
                <h3 class="font-editorial text-xl font-medium text-foreground">
                  {company.company}
                </h3>
                <p class="text-xs font-mono text-slate-400 mt-0.5">
                  {company.location}
                </p>
              </div>
            </div>
          </div>

          <div class="mt-5 space-y-5 sm:pl-5">
            {company.roles.map((role, rIndex) => (
              <div
                class={`relative ${rIndex > 0 ? 'border-t border-line pt-5' : ''}`}
              >
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-3">
                  <h4 class="text-sm font-semibold text-foreground sm:text-[15px]">
                    {role.title}
                  </h4>
                  <span class="text-xs font-mono text-slate-400 font-medium">
                    {role.period}
                  </span>
                </div>

                <ul class="space-y-1.5 pl-4">
                  {role.highlights
                    .slice(
                      0,
                      company.isCurrent && rIndex === 0
                        ? 4
                        : company.company === 'CSG'
                          ? 3
                          : 2,
                    )
                    .map((highlight) => (
                      <li class="list-disc text-xs leading-[1.65] text-body marker:text-accent">
                        {highlight}
                      </li>
                    ))}
                </ul>
              </div>
            ))}
          </div>
        </article>
      ))
    }

    <article class="border-t-2 border-foreground py-6">
      <h3 class="font-editorial text-2xl font-medium text-foreground">
        Education
      </h3>

      <div class="mt-5">
        <div>
          <div
            class="text-xs font-mono text-accent uppercase tracking-wider mb-1 font-semibold"
          >
            Degree
          </div>
          <div class="text-sm font-semibold text-white mb-0.5">
            {education.degree}
          </div>
          <div class="text-xs font-mono text-slate-400">
            {education.institution} · {education.period}
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
