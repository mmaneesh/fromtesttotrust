---
import { aboutData } from '../../data/about';

const chapterNumbers = ['I', 'II', 'III'];
---

<section
  id="view-about"
  role="tabpanel"
  aria-labelledby="tab-about"
  class="portfolio-view w-full pb-8"
>
  <header class="max-w-[760px] py-[42px] sm:py-[46px]">
    <h2
      class="max-w-[680px] font-editorial text-[28px] font-medium leading-[1.08] tracking-[-0.03em] text-foreground sm:text-[38px]"
    >
      Three chapters. One pursuit: software people can trust.
    </h2>
    <p class="mt-5 max-w-[760px] text-[15px] leading-[1.75] text-body">
      {aboutData.introduction}
    </p>
  </header>

  <div class="border-t border-line">
    {
      aboutData.evolutionStages.map((stage, index) => (
        <article class="grid gap-4 border-b border-line py-9 sm:grid-cols-[84px_minmax(0,1fr)] sm:gap-4 md:grid-cols-[96px_minmax(0,1fr)] md:gap-7">
          <div
            class="font-editorial text-lg italic text-accent"
            aria-hidden="true"
          >
            Chapter {chapterNumbers[index]}
          </div>
          <div class="min-w-0">
            <h3 class="font-editorial text-2xl font-medium leading-tight text-foreground">
              {stage.title}
            </h3>
            <p class="mt-2 max-w-[720px] text-sm leading-[1.72] text-body">
              {stage.narrative}
            </p>
            <div class="mt-6 grid gap-[22px] border-t border-line pt-5 md:grid-cols-3">
              {stage.keyPoints.map((point) => (
                <div>
                  <h4 class="mb-[7px] text-[10px] font-bold uppercase leading-4 tracking-[0.1em] text-accent">
                    {point.label}
                  </h4>
                  <p class="text-xs leading-[1.55] text-body">{point.text}</p>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
