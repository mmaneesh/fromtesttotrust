---
import { aboutData } from '../../data/about';
import { siteConfig } from '../../data/site-config';
const chapters = ['I', 'II', 'III'];
---

<section class="about-view w-full">
  <div class="hero">
    <div>
      <h1>
        Three chapters. One pursuit:<br /><em>software people can trust.</em>
      </h1><p class="lede">{aboutData.introduction}</p>
    </div><figure class="portrait">
      <img
        src="/images/maneesh-portrait-2026.jpg"
        alt="Maneesh Maddala, Principal SDET Engineer at Morningstar"
        width="558"
        height="697"
        fetchpriority="high"
        decoding="async"
      /><figcaption>
        <strong>{siteConfig.name}</strong><span
          >{siteConfig.role} · {siteConfig.employer}</span
        >
      </figcaption>
    </figure>
  </div>
  <div class="chapters">
    <header class="chapters-header">
      <h2 class="chapters-title">My Approach</h2>
      <span class="chapters-eyebrow">Three Chapters</span>
    </header>

    <div class="chapters-list">
      {
        aboutData.evolutionStages.map((stage, index) => (
          <article class="chapter-row">
            <div class="zone-identity">
              <strong class="chapter-roman">Chapter {chapters[index]}</strong>
              <h3 class="chapter-heading">{stage.title}</h3>
              <span class="chapter-era">{stage.era}</span>
            </div>

            <div class="zone-narrative">
              <p class="chapter-subtitle">{stage.subtitle}</p>
              <p class="chapter-narrative">{stage.narrative}</p>
            </div>

            <div class="zone-principles">
              {stage.keyPoints.map((point) => (
                <div class="principle-item">
                  <strong>{point.label}</strong>
                  <p>{point.text}</p>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
<style>
  .about-view {
    padding: var(--space-6) 0 var(--space-7);
  }
  .hero {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: var(--space-7);
    align-items: center;
  }
  h1,
  h2,
  h3 {
    font-family: var(--font-editorial);
    font-weight: 500;
  }
  h1 {
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    margin: 0 0 28px;
  }
  h1 em {
    color: rgb(var(--accent));
  }
  .lede {
    color: rgb(var(--body-text));
    margin: 0;
    font-size: var(--text-lead);
    line-height: var(--leading-body);
  }
  .portrait {
    position: relative;
    justify-self: end;
    width: min(100%, 360px);
    aspect-ratio: 1;
    margin: 0;
    overflow: hidden;
    background: rgb(var(--surface-deep));
    box-shadow: 0 10px 20px rgb(0 0 0 / 0.12);
  }
  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .portrait figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 12px 16px;
    background: rgb(var(--canvas) / 0.94);
    border-top: 1px solid rgb(var(--line));
  }
  .portrait strong,
  .portrait span {
    display: block;
    white-space: nowrap;
  }
  .portrait strong {
    font-size: var(--text-secondary);
    font-weight: 600;
    color: rgb(var(--foreground));
  }
  .portrait span {
    margin-top: 3px;
    color: rgb(var(--body-text));
    font: 500 11.5px / 1.4 var(--font-mono);
  }
  .chapters {
    margin-top: 84px;
  }
  .chapters-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 2px solid rgb(var(--foreground));
  }
  .chapters-title {
    font-size: clamp(2rem, 2.6vw, 2.375rem);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-title);
    margin: 0;
    color: rgb(var(--foreground));
  }
  .chapters-eyebrow {
    font: 600 var(--text-label) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgb(var(--muted-text));
  }
  .chapter-row {
    display: grid;
    grid-template-columns: 220px 1fr 436px;
    gap: 44px;
    align-items: start;
    padding: 36px 0;
  }
  .chapter-row + .chapter-row {
    border-top: 1px solid rgb(var(--line));
  }
  .chapter-roman {
    display: block;
    font: 700 14px / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgb(var(--accent));
  }
  .chapter-heading {
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: var(--tracking-heading);
    margin: 6px 0 0;
    color: rgb(var(--foreground));
  }
  .chapter-era {
    display: block;
    margin-top: 6px;
    font-size: 13.5px;
    color: rgb(var(--muted-text));
  }
  .zone-narrative {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .chapter-subtitle {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 19px;
    line-height: 1.35;
    margin: 0;
    color: rgb(var(--accent));
  }
  .chapter-narrative {
    margin: 0;
    font-size: var(--text-body);
    line-height: 1.7;
    color: rgb(var(--body-text));
  }
  .zone-principles {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-left: 28px;
    border-left: 1px solid rgb(var(--line));
  }
  .principle-item strong {
    display: block;
    font: 700 12.5px / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgb(var(--accent));
  }
  .principle-item p {
    margin: 3px 0 0;
    font-size: 15px;
    line-height: 1.45;
    white-space: nowrap;
    color: rgb(var(--body-text));
  }
  @media (max-width: 1024px) {
    .chapter-row {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 28px 0;
    }
    .zone-principles {
      padding-left: 0;
      padding-top: 16px;
      border-left: 0;
      border-top: 1px solid rgb(var(--line));
    }
    .principle-item p {
      white-space: normal;
    }
  }
  @media (max-width: 720px) {
    .about-view {
      padding: var(--space-5) 0 var(--space-6);
    }
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .portrait {
      justify-self: start;
      width: 100%;
      max-width: none;
    }
    .chapters {
      margin-top: 56px;
    }
  }
</style>
