---
import { speakingEvents } from '../../data/speaking';
---

<section
  id="view-speaking"
  role="tabpanel"
  aria-labelledby="tab-speaking"
  class="portfolio-view hidden w-full py-8 sm:py-9"
>
  <header class="mb-7 max-w-[640px]">
    <h2 class="font-editorial text-[28px] font-medium text-foreground">
      Insights
    </h2>
    <p class="mt-2 text-[13px] leading-[1.65] text-muted">
      Practical sessions on AI evaluation, guardrails, and tools for quality
      engineers.
    </p>
  </header>

  <div class="divide-y divide-line border-y border-line">
    {
      speakingEvents.map((event) => (
        <article class="grid gap-4 py-7 first:pt-6 sm:grid-cols-[minmax(9rem,0.32fr)_minmax(0,1fr)] sm:gap-10">
          <p class="text-[10px] font-mono uppercase tracking-[0.08em] text-accent">
            {event.organization}
          </p>
          <div>
            <a href={`/speaking/${event.id}`} class="group/title block">
              <h3 class="font-editorial text-xl font-medium leading-snug text-foreground transition-colors group-hover/title:text-accent">
                {event.title}
              </h3>
            </a>
            <p class="mt-3 max-w-[58ch] text-xs leading-[1.65] text-body">
              {event.abstract}
            </p>
            <a
              href={`/speaking/${event.id}`}
              class="mt-5 inline-flex text-xs font-mono font-semibold text-accent underline-offset-4 transition-colors hover:text-foreground hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span>View brief →</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
