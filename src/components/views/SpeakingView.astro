---
import { speakingEvents } from '../../data/speaking';
---

<section
  id="view-speaking"
  role="tabpanel"
  aria-labelledby="tab-speaking"
  class="portfolio-view hidden w-full py-8 sm:py-9"
>
  <header class="mb-7 max-w-[640px]">
    <h2 class="font-editorial text-[28px] font-medium text-foreground">
      Insights
    </h2>
    <p class="mt-2 text-[13px] leading-[1.65] text-muted">
      Practical sessions on AI evaluation, guardrails, and tools for quality
      engineers.
    </p>
  </header>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      speakingEvents.map((event) => (
        <article class="flex flex-col justify-between rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent/60">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-mono bg-accent/10 text-accent border border-accent/20">
                <span>{event.organization}</span>
              </span>
              <span class="text-[11px] font-mono text-slate-400">
                {event.format}
              </span>
            </div>

            <a href={`/speaking/${event.id}`} class="group/title block">
              <h3 class="font-editorial text-xl font-medium leading-snug text-foreground transition-colors group-hover/title:text-accent">
                {event.title}
              </h3>
            </a>
            <p class="text-xs font-mono text-accent/90 mb-4">
              {event.subtitle}
            </p>

            <p class="mb-5 text-xs leading-[1.65] text-body">
              {event.abstract}
            </p>
          </div>

          <div>
            <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
              <a
                href={`/speaking/${event.id}`}
                class="font-semibold text-accent hover:text-accent hover:underline"
              >
                <span>View brief →</span>
              </a>

              <a
                href={event.deckUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-medium text-white bg-accent/15 hover:bg-accent/25 border border-accent/35 transition-all shadow-glow-accent/15 group"
              >
                <span>Open Slides</span>
                <span class="group-hover:translate-x-0.5 transition-transform">
                  ↗
                </span>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
