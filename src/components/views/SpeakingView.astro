---
import { insightEntries } from '../../data/insights';

const visibleInsights = insightEntries.filter(
  (entry) => entry.published !== false,
);
---

<section class="w-full py-8 sm:py-10">
  <header class="mb-8">
    <h1 class="type-page-title text-foreground">Insights</h1>
    <p class="type-lead mt-3">
      Notes from the work: how we test, build AI systems, and make release
      decisions with evidence we can trust.
    </p>
  </header>

  <div class="divide-y divide-line border-t border-line">
    {
      visibleInsights.map((event) => (
        <article class="grid gap-4 py-8 first:pt-7 sm:grid-cols-[minmax(9rem,0.28fr)_minmax(0,1fr)] sm:gap-10">
          <p class="type-label pt-1 text-accent">{event.organization}</p>
          <div>
            <a href={`/insights/${event.id}`} class="group/title block">
              <h2 class="type-h2 text-foreground transition-colors group-hover/title:text-accent">
                {event.title}
              </h2>
            </a>
            <p class="type-body mt-3 text-body">{event.abstract}</p>
            <a
              href={`/insights/${event.id}`}
              class="mt-5 inline-flex text-[15px] font-mono font-semibold text-accent underline-offset-4 transition-colors hover:text-foreground hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span>
                {event.kind === 'article' ? 'Read article →' : 'View brief →'}
              </span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
