---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Page not found | Maneesh Maddala"
  description="This page could not be found."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <Header />

  <main
    id="main-content"
    class="flex-1 w-full max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 py-24 sm:py-32"
  >
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent mb-4">
      404
    </p>
    <h1 class="type-page-title text-foreground mb-5">
      This page could not be found.
    </h1>
    <p class="text-base text-body leading-relaxed mb-8 max-w-[520px]">
      The link may be broken or the page may have moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm font-mono font-semibold text-accent hover:text-foreground transition-colors"
    >
      <span>← Back to home</span>
    </a>
  </main>

  <Footer />
</BaseLayout>
