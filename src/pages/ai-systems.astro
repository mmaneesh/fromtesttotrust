---
import SectionLayout from '../layouts/SectionLayout.astro';
import AISystemsView from '../components/views/AISystemsView.astro';
import { aiSystems } from '../data/ai-systems';
import { siteOrigin } from '../lib/seo';

const site = siteOrigin(Astro.site);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'AI Systems — Maneesh Maddala',
    url: `${site}/ai-systems`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: aiSystems.map((system, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: system.title,
        url: `${site}/ai-systems/${system.id}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'About', item: `${site}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'AI Systems',
        item: `${site}/ai-systems`,
      },
    ],
  },
];
---

<SectionLayout
  title="AI Systems — Maneesh Maddala"
  description="Production AI systems built by Maneesh Maddala: a multi-agent SDLC workflow, a governed LiteLLM model gateway, evals and guardrails, support-intake automation, and a shared skills platform."
  structuredData={structuredData}
>
  <AISystemsView />
</SectionLayout>
