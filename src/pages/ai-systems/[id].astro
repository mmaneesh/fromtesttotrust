---
import SystemBrief from '../../components/SystemBrief.astro';
import { aiSystems, type AISystem } from '../../data/ai-systems';

export function getStaticPaths() {
  return aiSystems.map((system) => ({
    params: { id: system.id },
    props: { system },
  }));
}

interface Props {
  system: AISystem;
}

const { system } = Astro.props;
---

<SystemBrief system={system} />
