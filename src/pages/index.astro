---
import BaseLayout from '../layouts/BaseLayout.astro';
import ViewSwitcherDock from '../components/ViewSwitcherDock.astro';
import FieldNotesView from '../components/views/FieldNotesView.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site-config';

const site =
  Astro.site?.href.replace(/\/$/, '') ?? 'https://fromtesttotrust.com';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: siteConfig.name,
    url: `${site}/`,
    image: `${site}/images/maneesh-portrait-2026.jpg`,
    jobTitle: siteConfig.role,
    worksFor: { '@type': 'Organization', name: siteConfig.employer },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Chicago',
      addressRegion: 'IL',
    },
    sameAs: siteConfig.socials
      .filter((s) => s.id === 'linkedin' || s.id === 'github')
      .map((s) => s.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.brandName,
    url: `${site}/`,
  },
];
---

<BaseLayout
  title="Maneesh Maddala — Principal SDET Engineer | From Test to Trust"
  description="Portfolio of Maneesh Maddala, Principal SDET Engineer at Morningstar, Inc. — engineering quality, risk, and trust across modern AI systems, multi-agent SDLC, and enterprise test architecture."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <script is:inline>
      // Redirect legacy hash links to the real section routes.
      (() => {
        const map = {
          experience: '/experience',
          'ai-systems': '/ai-systems',
          speaking: '/speaking',
        };
        const dest = map[location.hash.slice(1)];
        if (dest) location.replace(dest);
      })();
    </script>
  </Fragment>

  <ViewSwitcherDock />

  <main
    id="main-content"
    class="mx-auto w-full max-w-[1024px] flex-1 px-4 sm:px-7"
  >
    <div class="mx-auto min-h-[500px] max-w-[1024px] pt-3 sm:pt-4">
      <FieldNotesView />
    </div>
  </main>

  <Footer />
</BaseLayout>
