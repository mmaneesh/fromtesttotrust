---
import BaseLayout from '../layouts/BaseLayout.astro';
import ViewSwitcherDock from '../components/ViewSwitcherDock.astro';
import AISystemsView from '../components/views/AISystemsView.astro';
import SpeakingView from '../components/views/SpeakingView.astro';
import CareerImpactView from '../components/views/CareerImpactView.astro';
import FieldNotesView from '../components/views/FieldNotesView.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="From Test to Trust - Maneesh Maddala | Principal SDET Engineer"
  description="Personal portfolio of Maneesh Maddala, Principal SDET Engineer at Morningstar, Inc. Engineering quality, risk, and trust across modern AI systems, multi-agent SDLC, and enterprise test architecture."
>
  <main
    id="main-content"
    class="mx-auto w-full max-w-[980px] flex-1 px-4 pt-3 sm:px-7 sm:pt-4"
  >
    <ViewSwitcherDock />

    <div class="min-h-[500px]">
      <FieldNotesView />
      <CareerImpactView />
      <AISystemsView />
      <SpeakingView />
    </div>
  </main>

  <Footer />
</BaseLayout>
