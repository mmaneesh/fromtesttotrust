---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { codeToHtml } from 'shiki';
import { insightEntries, type InsightEntry } from '../../data/insights';
import { siteOrigin, clampText } from '../../lib/seo';

export function getStaticPaths() {
  return insightEntries.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

interface Props {
  event: InsightEntry;
}

const { event } = Astro.props;

const site = siteOrigin(Astro.site);
const description = clampText(event.abstract);
const pageUrl = `${site}/insights/${event.id}`;
const parsedDate = new Date(event.date);
const publishedTime = Number.isNaN(parsedDate.valueOf())
  ? undefined
  : parsedDate.toISOString();

const sections = event.sections
  ? await Promise.all(
      event.sections.map(async (section) => ({
        ...section,
        highlightedCode:
          section.code && section.codeLanguage
            ? (
                await codeToHtml(section.code, {
                  lang: section.codeLanguage,
                  themes: {
                    light: 'github-light',
                    dark: 'one-dark-pro',
                  },
                })
              ).replace(/background-color:[^;"]+;?/, '')
            : undefined,
      })),
    )
  : undefined;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: event.title,
    description,
    url: pageUrl,
    image: `${site}/og.png`,
    ...(publishedTime ? { datePublished: publishedTime } : {}),
    author: { '@type': 'Person', name: 'Maneesh Maddala', url: `${site}/` },
    publisher: { '@type': 'Person', name: 'Maneesh Maddala' },
    about: `${event.format} — ${event.organization}`,
    keywords: event.tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Insights',
        item: `${site}/insights`,
      },
      { '@type': 'ListItem', position: 2, name: event.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={`${event.title} — ${event.format} | Maneesh Maddala`}
  description={description}
  type="article"
  publishedTime={publishedTime}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <Header />

  <main
    class="flex-1 max-w-[1024px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16"
  >
    <div class="mb-10">
      <a
        href="/insights"
        class="inline-flex items-center gap-2 text-xs font-mono text-accent hover:text-foreground transition-colors"
      >
        <span>← Back to Insights</span>
      </a>
    </div>

    <article class="pb-16">
      <header class="mb-12">
        <h1
          class="text-3xl sm:text-5xl font-display font-bold text-foreground leading-[1.05] tracking-tight mb-5"
        >
          {event.title}
        </h1>
        <p class="text-base sm:text-lg text-body leading-relaxed mb-7">
          {event.subtitle}
        </p>
        <p class="font-mono text-[11px] leading-6 text-muted">
          {event.organization} · {event.format} · {event.date}
        </p>
        <p class="font-mono text-[11px] leading-6 text-muted">
          {event.tags.join(' · ')}
        </p>
      </header>

      <div class="text-base text-body leading-8 space-y-7">
        <p>{event.brief}</p>
        {
          sections ? (
            <div class="space-y-10">
              {sections.map((section) => (
                <section class="space-y-4">
                  <h2 class="font-editorial text-2xl font-medium leading-snug text-foreground">
                    {section.heading}
                  </h2>
                  {section.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  {section.flow && (
                    <div class="example-surface grid justify-items-center gap-1 border border-line px-4 py-4 text-center font-mono text-[13px] leading-6 text-foreground">
                      {section.flow.map((step, index) => (
                        <>
                          <p>{step}</p>
                          {index < section.flow!.length - 1 && (
                            <span aria-hidden="true" class="text-accent">
                              ↓
                            </span>
                          )}
                        </>
                      ))}
                    </div>
                  )}
                  {section.highlightedCode && (
                    <div
                      class="example-surface overflow-x-auto border border-line [&_pre]:m-0 [&_pre]:p-4! [&_pre]:text-[13px]! [&_pre]:leading-6! [&_pre]:font-mono!"
                      set:html={section.highlightedCode}
                    />
                  )}
                </section>
              ))}
            </div>
          ) : (
            <ol class="space-y-6">
              {event.keyTakeaways.map((takeaway, idx) => (
                <li class="grid grid-cols-[2rem_1fr] gap-4">
                  <span class="font-mono text-xs font-semibold text-accent">
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  <p class="text-sm sm:text-base text-body leading-7">
                    {takeaway}
                  </p>
                </li>
              ))}
            </ol>
          )
        }
        {
          event.deckUrl && (
            <div class="mt-3 border-t border-line pt-7">
              <a
                href={event.deckUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 font-mono text-sm font-semibold text-accent hover:text-foreground transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                <span>Open the presentation deck</span>
                <svg
                  class="h-3.5 w-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14 4h6v6" />
                  <path d="M20 4 10 14" />
                  <path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
                </svg>
              </a>
            </div>
          )
        }
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .example-surface {
    background: rgb(var(--surface-raised));
  }

  :global(:root[data-theme='light']) .example-surface {
    background: rgb(230 221 210);
  }

  :global(:root[data-theme='dark']) .example-surface :global(.shiki),
  :global(:root[data-theme='dark']) .example-surface :global(.shiki span) {
    color: var(--shiki-dark) !important;
  }

  :global(:root[data-theme='dark']) .example-surface :global(.shiki) {
    background: var(--shiki-dark-bg) !important;
  }
</style>
