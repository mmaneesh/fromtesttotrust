---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TechTag from '../../components/TechTag.astro';
import { speakingEvents, type SpeakingEvent } from '../../data/speaking';

export function getStaticPaths() {
  return speakingEvents.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

interface Props {
  event: SpeakingEvent;
}

const { event } = Astro.props;
---

<BaseLayout
  title={`${event.title} — Keynote & Workshop | Maneesh Maddala`}
  description={event.abstract}
>
  <Header />

  <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Back Navigation -->
    <div class="mb-8">
      <a
        href="/#speaking"
        class="inline-flex items-center gap-2 text-xs font-mono text-cyan-accent hover:text-cyan-300 transition-colors"
      >
        <span>← Back to Speaking Index</span>
      </a>
    </div>

    <!-- Keynote Header -->
    <header class="mb-10 pb-8 border-b border-white/[0.08]">
      <div class="flex items-center gap-2 mb-3">
        <span
          class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-mono bg-cyan-accent/10 text-cyan-300 border border-cyan-accent/20"
        >
          <span>🎙️</span>
          <span>{event.organization}</span>
        </span>
        <span class="text-slate-600">·</span>
        <span class="text-xs font-mono text-slate-400">{event.format}</span>
        <span class="text-slate-600">·</span>
        <span class="text-xs font-mono text-emerald-400">{event.date}</span>
      </div>

      <h1
        class="text-2xl sm:text-4xl font-display font-extrabold text-white leading-tight tracking-tight mb-3"
      >
        {event.title}
      </h1>

      <p class="text-base font-mono text-cyan-accent/90 mb-6">
        {event.subtitle}
      </p>

      <div class="flex flex-wrap gap-2">
        {event.tags.map((tag) => <TechTag tag={tag} />)}
      </div>
    </header>

    <!-- Presentation Action Callout -->
    <section
      class="mb-10 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-cyan-950/40 via-surface to-slate-900 border border-cyan-accent/30 shadow-[0_0_30px_-5px_rgba(56,189,248,0.2)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6"
    >
      <div>
        <div
          class="text-xs font-mono text-cyan-accent uppercase tracking-wider mb-1 font-semibold"
        >
          Interactive Presentation Deck
        </div>
        <h2 class="text-lg font-display font-bold text-white mb-1">
          Explore Live Slide Deck on Vercel
        </h2>
        <p class="text-xs text-slate-300">
          Full interactive keynote slides, live framework diagrams, and code
          snippets.
        </p>
      </div>

      <a
        href={event.deckUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs font-mono font-bold text-slate-950 bg-cyan-accent hover:bg-cyan-300 transition-all shadow-glow-cyan shrink-0"
      >
        <span>Open Slide Deck</span>
        <span>↗</span>
      </a>
    </section>

    <!-- Abstract & Session Overview -->
    <section
      class="mb-10 p-6 sm:p-8 rounded-2xl bg-[#0B0F19] border border-white/[0.08]"
    >
      <h2
        class="text-sm font-mono font-bold uppercase tracking-wider text-slate-300 mb-4 flex items-center gap-2"
      >
        <span>01 // Session Abstract & Core Thesis</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-light">
        {event.abstract}
      </p>
    </section>

    <!-- Key Takeaways for Engineering Teams -->
    <section
      class="mb-12 p-6 sm:p-8 rounded-2xl bg-[#0B0F19] border border-white/[0.08]"
    >
      <h2
        class="text-sm font-mono font-bold uppercase tracking-wider text-slate-300 mb-6 flex items-center gap-2"
      >
        <span>02 // Key Takeaways & Actionable Frameworks</span>
      </h2>

      <div class="space-y-4">
        {
          event.keyTakeaways.map((takeaway, idx) => (
            <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.04] flex items-start gap-3">
              <span class="text-xs font-mono font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 shrink-0">
                0{idx + 1}
              </span>
              <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
                {takeaway}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Outbound Actions -->
    <div
      class="p-6 rounded-2xl bg-[#0B0F19] border border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <div>
        <div class="text-sm font-bold text-white mb-0.5">
          Interested in inviting Maneesh to speak?
        </div>
        <p class="text-xs text-slate-400 font-mono">
          Available for conferences, technical workshops, and panel keynotes.
        </p>
      </div>

      <a
        href="https://www.linkedin.com/in/maneesh-maddala/"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 rounded-xl text-xs font-mono font-semibold text-white bg-cyan-accent/20 hover:bg-cyan-accent/30 border border-cyan-accent/40 transition-colors shrink-0"
      >
        Connect on LinkedIn ↗
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
