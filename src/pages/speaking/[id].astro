---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { speakingEvents, type SpeakingEvent } from '../../data/speaking';

export function getStaticPaths() {
  return speakingEvents.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

interface Props {
  event: SpeakingEvent;
}

const { event } = Astro.props;
---

<BaseLayout
  title={`${event.title} - Keynote & Workshop | Maneesh Maddala`}
  description={event.abstract}
>
  <Header />

  <main class="flex-1 max-w-[1024px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="mb-10">
      <a
        href="/#speaking"
        class="inline-flex items-center gap-2 text-xs font-mono text-accent hover:text-foreground transition-colors"
      >
        <span>← Back to Speaking</span>
      </a>
    </div>

    <article class="pb-16">
      <header class="mb-12">
        <h1 class="text-3xl sm:text-5xl font-display font-bold text-foreground leading-[1.05] tracking-tight mb-5">
          {event.title}
        </h1>
        <p class="text-base sm:text-lg text-body leading-relaxed mb-7">{event.subtitle}</p>
        <p class="font-mono text-[11px] leading-6 text-muted">{event.tags.join(' · ')}</p>
      </header>

      <div class="text-base text-body leading-8 space-y-7">
        <p>{event.abstract}</p>
        <ol class="space-y-6">
          {event.keyTakeaways.map((takeaway, idx) => (
            <li class="grid grid-cols-[2rem_1fr] gap-4">
              <span class="font-mono text-xs font-semibold text-accent">{String(idx + 1).padStart(2, '0')}</span>
              <p class="text-sm sm:text-base text-body leading-7">{takeaway}</p>
            </li>
          ))}
        </ol>
        <p>Slides, framework diagrams, and code examples from the session are available in the <a href={event.deckUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-sm font-semibold text-accent hover:text-foreground transition-colors">presentation deck ↗</a>.</p>
      </div>

      <footer class="mt-14 pt-8 border-t border-line flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
        <p class="text-sm text-muted">Available for conferences, technical workshops, and panels.</p>
        <a href="https://www.linkedin.com/in/maneesh-maddala/" target="_blank" rel="noopener noreferrer" class="font-mono text-xs font-semibold text-accent hover:text-foreground transition-colors">Connect ↗</a>
      </footer>
    </article>
  </main>

  <Footer />
</BaseLayout>
