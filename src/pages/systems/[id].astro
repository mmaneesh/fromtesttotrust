---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AgentPipelineBrief from '../../components/AgentPipelineBrief.astro';
import GatewayDiagrams from '../../components/GatewayDiagrams.astro';
import SupportIntakeDiagram from '../../components/SupportIntakeDiagram.astro';
import BrandAuditDiagram from '../../components/BrandAuditDiagram.astro';
import SkillsRepoDiagram from '../../components/SkillsRepoDiagram.astro';
import { aiSystems, type AISystem } from '../../data/ai-systems';

export function getStaticPaths() {
  return aiSystems.map((system) => ({
    params: { id: system.id },
    props: { system },
  }));
}

interface Props {
  system: AISystem;
}

const { system } = Astro.props;

// Detailed system blueprints and implementation context
const systemDetails: Record<
  string,
  {
    riskAnalysis: { risk: string; mitigation: string }[];
  }
> = {
  'multi-agent-sdlc': {
    riskAnalysis: [
      {
        risk: 'Jira tickets can be incomplete or ambiguous, leaving the planner too little to build strong scenarios from.',
        mitigation:
          'Before planning begins, the workflow gathers acceptance criteria, documentation, attachments, references, parent-epic context, and completed or in-review sibling tickets.',
      },
      {
        risk: 'TestRail can already contain similar coverage, or the right folder may not exist.',
        mitigation:
          'The TestRail step inspects the project and folder hierarchy, compares similar functionality, and returns every updated or created case link for review.',
      },
      {
        risk: 'Tests turn brittle when the automation ignores the repository’s existing conventions.',
        mitigation:
          'The Playwright step reads the repository structure, routes work to UI, API, visual, or component suites, reuses page objects and fixtures, and prefers user-facing locators.',
      },
    ],
  },
  'litellm-gateway': {
    riskAnalysis: [
      {
        risk: 'A long-running or stuck agent could hold resources with nothing to show for it.',
        mitigation:
          'Each run is an ephemeral Fargate task with its own lifecycle, and an EventBridge reaper shuts down tasks that pass their time budget.',
      },
      {
        risk: 'Two events for the same ticket could start duplicate work.',
        mitigation:
          'The dev-loop-api Lambda takes a per-ticket lock in DynamoDB before it enqueues anything, so it drops any second event for a ticket already in flight.',
      },
      {
        risk: 'A single model provider outage could stall every run.',
        mitigation:
          'Model calls go through LiteLLM rather than a provider SDK, so a request routes to OpenRouter or AWS Bedrock and falls back to the default provider when the selected one is down.',
      },
      {
        risk: 'Scattered API keys would make model access hard to govern or revoke.',
        mitigation:
          'LiteLLM authorizes every call against an Okta-provisioned identity, so provider access is one policy the platform team manages, and sandboxes read only short-lived credentials from Secrets Manager.',
      },
    ],
  },
  'llm-guardrails-evals': {
    riskAnalysis: [
      {
        risk: 'Probabilistic output hallucinations in client-facing features',
        mitigation:
          'Statistical evaluation suites measuring semantic distance and factuality against verified ground truth.',
      },
      {
        risk: 'Prompt injection & boundary bypass',
        mitigation:
          'Red-team datasets that test model behavior in CI/CD pull request checks.',
      },
      {
        risk: 'Silent regression when underlying foundational models update',
        mitigation:
          'Non-deterministic benchmark suites executed nightly to track output drift and semantic consistency.',
      },
    ],
  },
  'support-intake-agent': {
    riskAnalysis: [
      {
        risk: 'Pulling four channels into one Teams channel could bury real issues under noise.',
        mitigation:
          'The workflow creates nothing in Asana on its own; the team reads every message in the queue, and only a deliberate action on one starts the Power Automate flow.',
      },
      {
        risk: 'A request forwarded in from email or Slack often arrives without its attachments or the name of the person who sent it.',
        mitigation:
          'Each webhook captures the sender and files at the source and attaches them to the Teams message, and the flow copies the requestor, description, and attachments into the Asana task.',
      },
      {
        risk: 'When the team routes by hand, tasks land with the wrong group and bounce back.',
        mitigation:
          'The flow matches each request type to one owning team and assigns the Asana task to that team’s project, so the same kind of request always goes to the same place.',
      },
    ],
  },
  'shared-skills-platform': {
    riskAnalysis: [
      {
        risk: 'Two people can still start the same skill at the same time.',
        mitigation:
          'Anyone can search the repository before building, in GitHub or through the Claude Desktop connector, so an existing skill surfaces before a duplicate is written.',
      },
      {
        risk: 'A skill published by another team can misbehave, and it is not obvious who to ask.',
        mitigation:
          'Every skill is published with its author’s username attached, so a question or a malfunction routes straight to the person who wrote it.',
      },
      {
        risk: 'A GitHub-based catalog could shut out non-technical staff.',
        mitigation:
          'The Claude Desktop connector gives them the same search and the same publish path from chat, so the repository is not developer-only.',
      },
    ],
  },
  'brand-unification-skill': {
    riskAnalysis: [
      {
        risk: 'A skill with broad rewrite instructions can drift into editorializing or changing meaning.',
        mitigation:
          'Every pass is bound to a written rule set, and the skill records the specific rule behind each finding, so a reviewer can check any change against its source.',
      },
      {
        risk: 'A long audit can fill the context with rule text and stale page content until the model loses the thread.',
        mitigation:
          'The skill uses progressive disclosure: it loads only the rule files each step needs and drops page content once a step is scored, so the working context stays small.',
      },
      {
        risk: 'Some off-brand content is a legal question, not a copy edit.',
        mitigation:
          'The escalation rule set routes each finding to the content team or legal, and the skill returns a score and a draft but never publishes, so a person still makes the edit and the release call.',
      },
    ],
  },
};

const details = systemDetails[system.id] || systemDetails['multi-agent-sdlc'];
---

<BaseLayout
  title={`${system.title} - From Test to Trust | Maneesh Maddala`}
  description={system.summary}
>
  <Header />

  <main
    class="flex-1 w-full max-w-[1024px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16"
  >
    <div class="mb-10">
      <a
        href="/#ai-systems"
        class="inline-flex items-center gap-2 text-xs font-mono text-accent hover:text-foreground transition-colors"
      >
        <span>← Back to AI Systems</span>
      </a>
    </div>

    <article class="pb-16">
      <header class="mb-12">
        <h1
          class="text-[34px] sm:text-[42px] font-display font-bold text-foreground leading-[1.05] tracking-tight mb-5"
        >
          {system.title}
        </h1>
        <p class="text-base sm:text-lg text-body leading-relaxed mb-7">
          {system.subtitle}
        </p>
        <p class="font-mono text-[11px] leading-6 text-muted">
          {system.technologies.join(' · ')}
        </p>
      </header>

      <div class="text-base text-body leading-8 space-y-7">
        <p>{system.problem}</p>
        <p>{system.summary}</p>
        {system.architecture.map((arch) => <p>{arch}</p>)}
        {
          system.workflow && (
            <p>
              Each step produces an artifact that someone can review before the
              next step begins.
            </p>
          )
        }
      </div>
      {
        system.workflow && (
          <AgentPipelineBrief workflow={system.workflow} diagramsOnly />
        )
      }
      {system.id === 'litellm-gateway' && <GatewayDiagrams />}
      {system.id === 'support-intake-agent' && <SupportIntakeDiagram />}
      {system.id === 'brand-unification-skill' && <BrandAuditDiagram />}
      {system.id === 'shared-skills-platform' && <SkillsRepoDiagram />}
      <div class="mt-7 text-base text-body leading-8 space-y-7">
        {
          details.riskAnalysis.map((item) => (
            <p>
              {item.risk} {item.mitigation}
            </p>
          ))
        }
        {system.impact.map((item) => <p>{item}</p>)}
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
