---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AgentPipelineBrief from '../../components/AgentPipelineBrief.astro';
import GatewayDiagrams from '../../components/GatewayDiagrams.astro';
import SupportIntakeDiagram from '../../components/SupportIntakeDiagram.astro';
import BrandAuditDiagram from '../../components/BrandAuditDiagram.astro';
import SkillsRepoDiagram from '../../components/SkillsRepoDiagram.astro';
import OfficeHoursDiagram from '../../components/OfficeHoursDiagram.astro';
import DefectTriageDiagram from '../../components/DefectTriageDiagram.astro';
import { aiSystems, type AISystem } from '../../data/ai-systems';
import { siteOrigin, clampText } from '../../lib/seo';

export function getStaticPaths() {
  return aiSystems.map((system) => ({
    params: { id: system.id },
    props: { system },
  }));
}

interface Props {
  system: AISystem;
}

const { system } = Astro.props;

// Detailed system blueprints and implementation context
const systemDetails: Record<
  string,
  {
    riskAnalysis: { risk: string; mitigation: string }[];
  }
> = {
  'multi-agent-sdlc': {
    riskAnalysis: [
      {
        risk: 'A thin or ambiguous ticket leaves the planning stage with little to work from.',
        mitigation:
          'Before it drafts a single scenario, the workflow gathers the acceptance criteria, the technical notes and attachments, the parent epic, and any sibling tickets that are done or in review, so the plan starts from the full picture.',
      },
      {
        risk: 'TestRail often already holds similar coverage, and the right folder may not exist yet.',
        mitigation:
          'The coverage stage walks the project and folder hierarchy first, compares against similar functionality, and returns every case it touched for review before it counts.',
      },
      {
        risk: 'Automation that ignores a repository’s conventions ages badly.',
        mitigation:
          'The automation stage reads the repository structure, routes each test into the suite that fits, and reuses the existing page objects, fixtures, and user-facing locators.',
      },
    ],
  },
  'litellm-gateway': {
    riskAnalysis: [
      {
        risk: 'A stuck agent could hold a Fargate task open with nothing to show for it.',
        mitigation:
          'Each run is an ephemeral task with its own lifecycle, and an EventBridge reaper shuts down anything that passes its time budget.',
      },
      {
        risk: 'Two events for one ticket could start the work twice.',
        mitigation:
          'The dev-loop-api Lambda takes a per-ticket lock in DynamoDB before it enqueues anything, so it drops any second event for a ticket already in flight.',
      },
      {
        risk: 'One model provider having an outage could stall every run.',
        mitigation:
          'Every call goes through LiteLLM rather than a provider SDK, so a request can route to OpenRouter or AWS Bedrock and fall back to the default provider when the first choice is down.',
      },
      {
        risk: 'Provider keys spread across repositories would be hard to govern or revoke.',
        mitigation:
          'LiteLLM authorizes every call against an Okta-provisioned identity, so access is one policy the platform team manages, and each sandbox only ever reads short-lived credentials from Secrets Manager.',
      },
    ],
  },
  'office-hours-agent': {
    riskAnalysis: [
      {
        risk: 'A transcript pulled straight from a recording is messy: crosstalk, filler, half-finished sentences.',
        mitigation:
          'The conversion step rewrites each .vtt into clean Markdown and titles it by topic before anything is indexed, so the agent retrieves readable passages rather than raw captions.',
      },
      {
        risk: 'A real question rarely maps to a single session; the answer is spread across several.',
        mitigation:
          'The transcripts are indexed by meaning, so related material sits together no matter which session it came from, and the agent gathers across all of it before it answers.',
      },
      {
        risk: 'An agent over a knowledge base can drift into answering from general knowledge instead of the source.',
        mitigation:
          'The agent answers only from the retrieved office-hours passages and names the sessions it drew from, so a reader can go back to the original.',
      },
    ],
  },
  'support-intake-agent': {
    riskAnalysis: [
      {
        risk: 'Funneling four channels into one could just relocate the noise instead of clearing it.',
        mitigation:
          'The workflow creates nothing in Asana on its own. The team still reads every message, and a task appears only when someone runs the action on a specific one.',
      },
      {
        risk: 'A request forwarded from email or Slack often loses its attachments and the name of the person who raised it.',
        mitigation:
          'Each webhook captures the sender and the files at the source and carries them on the Teams message, and the flow copies all of it into the Asana task.',
      },
      {
        risk: 'Routing by hand sends tasks to the wrong team, where they stall and get bounced back.',
        mitigation:
          'The flow matches each request type to one owning team and assigns the Asana task to that team’s project, so the same kind of request always goes to the same place.',
      },
    ],
  },
  'shared-skills-platform': {
    riskAnalysis: [
      {
        risk: 'Two people can still start the same skill on the same day.',
        mitigation:
          'The workflow cannot prevent that, but it makes checking cheap: anyone can search the repo first, in GitHub or through the connector, before they build anything.',
      },
      {
        risk: 'When a skill from another team malfunctions, you need to know who to ask.',
        mitigation:
          'Every skill is published with its author’s username attached, so a question or a bug goes straight to the person who wrote it.',
      },
      {
        risk: 'A GitHub-based catalog could leave out everyone who does not work in GitHub.',
        mitigation:
          'The Claude Desktop connector gives them the same search and the same way to publish, from chat, so the repository is not developer-only.',
      },
    ],
  },
  'defect-triaging-agent': {
    riskAnalysis: [
      {
        risk: 'Sending dozens of full monocart-html reports to the model would waste context and make the analysis less reliable.',
        mitigation:
          'We parse each artifact first and pass the model only the compact, aggregated spec-level evidence it needs: attempt outcomes, final outcome, duration, timestamp, and sanitized error data.',
      },
      {
        risk: 'A test that passes after retry can look healthy in a final-result-only view even when it is unstable.',
        mitigation:
          'We retain the initial attempt and both retries, so the report separates flaky specs from specs that still fail after all retry attempts.',
      },
      {
        risk: 'Complex tests can take longer than the rest of the suite and should not automatically become defects.',
        mitigation:
          'We compare each spec with the suite baseline and its own daily history, then prioritize material slowdowns while keeping stable long-running specs as context.',
      },
    ],
  },
  'brand-unification-skill': {
    riskAnalysis: [
      {
        risk: 'A skill with broad rewrite instructions can drift into editorializing or changing meaning.',
        mitigation:
          'Every pass is bound to a written rule set, and the skill records the specific rule behind each finding, so a reviewer can check any change against its source.',
      },
      {
        risk: 'A long audit can fill the context with rule text and stale page content until the model loses the thread.',
        mitigation:
          'The skill uses progressive disclosure: it loads only the rule files each step needs and drops page content once a step is scored, so the working context stays small.',
      },
      {
        risk: 'Some off-brand content is a legal question, not a copy edit.',
        mitigation:
          'The escalation rule set routes each finding to the content team or legal, and the skill returns a score and a draft but never publishes, so a person still makes the edit and the release call.',
      },
    ],
  },
};

const details = systemDetails[system.id] || systemDetails['multi-agent-sdlc'];

const site = siteOrigin(Astro.site);
const description = clampText(system.summary);
const pageUrl = `${site}/systems/${system.id}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: system.title,
    description,
    url: pageUrl,
    image: `${site}/og.png`,
    author: { '@type': 'Person', name: 'Maneesh Maddala', url: `${site}/` },
    publisher: { '@type': 'Person', name: 'Maneesh Maddala' },
    keywords: system.technologies.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'AI Systems',
        item: `${site}/ai-systems`,
      },
      { '@type': 'ListItem', position: 2, name: system.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={`${system.title} — AI System Brief | Maneesh Maddala`}
  description={description}
  type="article"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <Header />

  <main
    class="flex-1 w-full max-w-[1024px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16"
  >
    <div class="mb-10">
      <a
        href="/ai-systems"
        class="inline-flex items-center gap-2 text-xs font-mono text-accent hover:text-foreground transition-colors"
      >
        <span>← Back to AI Systems</span>
      </a>
    </div>

    <article class="pb-16">
      <header class="mb-12">
        <h1
          class="text-[34px] sm:text-[42px] font-display font-bold text-foreground leading-[1.05] tracking-tight mb-5"
        >
          {system.title}
        </h1>
        <p class="text-base sm:text-lg text-body leading-relaxed mb-7">
          {system.subtitle}
        </p>
        <p class="font-mono text-[11px] leading-6 text-muted">
          {system.technologies.join(' · ')}
        </p>
      </header>

      <div class="text-base text-body leading-8 space-y-7">
        <p>{system.problem}</p>
        <p>{system.summary}</p>
        {system.architecture.map((arch) => <p>{arch}</p>)}
        {
          system.workflow && (
            <p>
              Each step produces an artifact that someone can review before the
              next step begins.
            </p>
          )
        }
      </div>
      {
        system.workflow && (
          <AgentPipelineBrief workflow={system.workflow} diagramsOnly />
        )
      }
      {system.id === 'litellm-gateway' && <GatewayDiagrams />}
      {system.id === 'support-intake-agent' && <SupportIntakeDiagram />}
      {system.id === 'brand-unification-skill' && <BrandAuditDiagram />}
      {system.id === 'shared-skills-platform' && <SkillsRepoDiagram />}
      {system.id === 'office-hours-agent' && <OfficeHoursDiagram />}
      {system.id === 'defect-triaging-agent' && <DefectTriageDiagram />}
      <div class="mt-7 text-base text-body leading-8 space-y-7">
        {
          details.riskAnalysis.map((item) => (
            <p>
              {item.risk} {item.mitigation}
            </p>
          ))
        }
        {system.impact.map((item) => <p>{item}</p>)}
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
